define ViewBox(0, 0, 320, 150);

define default PathLayer('marks') #{
  fill: none;
  stroke: #c0518e;
  stroke-width: 2;
}

// After: say the value once. Enum members and string literals both work,
// and Dot, Spark share one body. No fallthrough, so no break.
enum MarkerShape {
  Dot,
  Ring,
  Box,
  Spark,
}

let rows = [
  [
    MarkerShape.Dot,
    MarkerShape.Ring,
    MarkerShape.Box,
    MarkerShape.Spark,
    MarkerShape.Ring,
  ],
  [
    MarkerShape.Ring,
    MarkerShape.Box,
    MarkerShape.Dot,
    MarkerShape.Dot,
    MarkerShape.Spark,
  ],
];

for ([kinds, row] in rows) {
  let cy = 45 + row * 60;
  for ([kind, index] in kinds) {
    let cx = 40 + index * 60;
    switch(kind) {
      case MarkerShape.Dot {
        circle(cx, cy, 10);
      }
      case MarkerShape.Ring {
        circle(cx, cy, 16);
        circle(cx, cy, 8);
      }
      case MarkerShape.Box {
        rect(cx - 12, cy - 12, 24, 24);
      }
      default {
        star(cx,
            cy,
            16,
            7,
            5);
      }
    }
  }
}
