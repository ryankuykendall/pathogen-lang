define ViewBox(0, 0, 320, 150);

define default PathLayer('marks') #{
  fill: none;
  stroke: #c0518e;
  stroke-width: 2;
}

// Before: the same value compared on every branch. Two rows of markers,
// and `kind` is tested up to three times per marker.
let rows = [
  [
    'dot',
    'ring',
    'box',
    'spark',
    'ring',
  ],
  [
    'ring',
    'box',
    'dot',
    'dot',
    'spark',
  ],
];

for ([kinds, row] in rows) {
  let cy = 45 + row * 60;
  for ([kind, index] in kinds) {
    let cx = 40 + index * 60;
    if (kind == 'dot') {
      circle(cx, cy, 10);
    } else if (kind == 'ring') {
      circle(cx, cy, 16);
      circle(cx, cy, 8);
    } else if (kind == 'box') {
      rect(cx - 12, cy - 12, 24, 24);
    } else {
      star(cx,
          cy,
          16,
          7,
          5);
    }
  }
}
