// viewBox="0 0 400 400"
// Reactive Colors — CSSVar-Driven Gradient Palette
// Change --primary or --accent to recolor the entire composition

// --- Reactive base colors (override via CSS custom properties) ---

let primary = Color(CSSVar('--primary', '#2563eb'));
let accent  = Color(CSSVar('--accent',  '#e63946'));
let surface = Color(CSSVar('--surface', '#1a1a2e'));

// --- Derived palette (all reactive — change the base, everything follows) ---

let primary_light = primary.lighten(0.2);
let primary_dark  = primary.darken(0.15);
let accent_warm   = accent.hueShift(-20);
let accent_soft   = accent.lighten(0.15);
let complement    = primary.hueShift(180);

// --- Gradients using reactive colors ---

let hero_grad = LinearGradient('hero', 0, 0, 1, 1) {|g|
  g.stop(0,   primary_dark);
  g.stop(0.5, primary);
  g.stop(1,   primary_light);
};

let accent_grad = LinearGradient('accent-bar', 0, 0, 1, 0) {|g|
  g.stop(0,   accent);
  g.stop(0.5, accent_warm);
  g.stop(1,   accent_soft);
};

let glow_grad = RadialGradient('glow', 0.5, 0.5, 0.6) {|g|
  g.stop(0,   primary_light);
  g.stop(0.5, primary);
  g.stop(1,   surface);
};

let badge_grad = RadialGradient('badge', 0.4, 0.4, 0.5) {|g|
  g.stop(0,   accent_soft);
  g.stop(0.6, accent);
  g.stop(1,   accent_warm);
};

let complement_grad = LinearGradient('complement', 0, 0, 0, 1) {|g|
  g.stop(0,   complement);
  g.stop(1,   primary_dark);
};

// --- Background ---

let bg = PathLayer('bg') ${ fill: surface; stroke: none; };
bg.apply { rect(0, 0, 400, 400) }

// --- Ambient glow behind the card ---

let glow = PathLayer('glow') ${ fill: glow_grad; stroke: none; opacity: 0.5; };
glow.apply { circle(200, 200, 180); closePath() }

// --- Hero card with primary gradient ---

let card = PathLayer('card') ${ fill: hero_grad; stroke: none; };
card.apply { roundRect(40, 60, 200, 140, 12) }

let card_border = PathLayer('card-border') ${ fill: none; stroke: primary_light; stroke-width: 1; opacity: 0.4; };
card_border.apply { roundRect(40, 60, 200, 140, 12) }

// --- Accent bar ---

let bar = PathLayer('bar') ${ fill: accent_grad; stroke: none; };
bar.apply { roundRect(40, 220, 320, 8, 4) }

// --- Badge circles ---

let b1 = PathLayer('badge1') ${ fill: badge_grad; stroke: none; };
b1.apply { circle(300, 100, 35); closePath() }

let b2 = PathLayer('badge2') ${ fill: badge_grad; stroke: none; opacity: 0.6; };
b2.apply { circle(340, 155, 20); closePath() }

// --- Complement sidebar ---

let sidebar = PathLayer('sidebar') ${ fill: complement_grad; stroke: none; };
sidebar.apply { roundRect(40, 250, 50, 120, 8) }

// --- Small reactive chips ---

let chip1 = PathLayer('chip1') ${ fill: primary; stroke: none; };
chip1.apply { roundRect(110, 260, 80, 28, 14) }

let chip2 = PathLayer('chip2') ${ fill: accent; stroke: none; };
chip2.apply { roundRect(200, 260, 80, 28, 14) }

let chip3 = PathLayer('chip3') ${ fill: complement; stroke: none; };
chip3.apply { roundRect(290, 260, 80, 28, 14) }

// --- Progress bars using derived colors ---

let track = PathLayer('track') ${ fill: primary_dark; stroke: none; opacity: 0.4; };
track.apply { roundRect(110, 310, 260, 8, 4) }

let fill_bar = PathLayer('fill-bar') ${ fill: hero_grad; stroke: none; };
fill_bar.apply { roundRect(110, 310, 180, 8, 4) }

let track2 = PathLayer('track2') ${ fill: primary_dark; stroke: none; opacity: 0.4; };
track2.apply { roundRect(110, 335, 260, 8, 4) }

let fill_bar2 = PathLayer('fill-bar2') ${ fill: accent_grad; stroke: none; };
fill_bar2.apply { roundRect(110, 335, 130, 8, 4) }

// --- Labels ---

let labels = TextLayer('labels') ${
  font-family: system-ui, sans-serif;
  font-size: 11;
  fill: #888;
  text-anchor: start;
};
labels.apply {
  text(48, 85)`--primary`
  text(270, 85)`--accent`
  text(135, 282)`primary`
  text(225, 282)`accent`
  text(305, 282)`complement`
}

let title = TextLayer('title') ${
  font-family: system-ui, sans-serif;
  font-size: 15;
  fill: #ccc;
  text-anchor: middle;
  font-weight: bold;
};
title.apply {
  text(200, 390)`Reactive Colors: Override CSS Variables to Retheme`
}

// --- Scene ---

let scene = GroupLayer('scene') ${};
scene.append(bg, glow, card, card_border, bar, b1, b2, sidebar, chip1, chip2, chip3, track, fill_bar, track2, fill_bar2, labels, title)
