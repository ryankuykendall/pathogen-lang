let l8t = TextLayer('l8') ${
  font-family: sans-serif;
  font-size: 12;
  font-weight: 600;
  fill: oklch(25% 0.02 270);
  text-anchor: middle;
};
l8t.apply {
  text(407, 200)`elevation = 8`;
}

let l16 = TextLayer('l16') ${
  font-family: sans-serif;
  font-size: 12;
  font-weight: 600;
  fill: oklch(25% 0.02 270);
  text-anchor: middle;
};
l16.apply {
  text(522, 200)`elevation = 16`;
