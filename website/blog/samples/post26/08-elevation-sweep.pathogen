let l24 = TextLayer('l24') ${
  font-family: sans-serif;
  font-size: 12;
  font-weight: 600;
  fill: oklch(25% 0.02 270);
  text-anchor: middle;
};
l24.apply {
  text(637, 200)`elevation = 24`;
}
