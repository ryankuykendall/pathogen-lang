define ViewBox(0, 0, 520, 220);
// compoundVariableOffset: two profiles (one per side of the spine) close into
// a single filled, variable-width ribbon. The dashed rail is drawn on top so
// you can see it running through the middle.

// ─── Core tokens ──────────────────────────────────────────────
let bg_color = Color(CSSVar('--bg', #d0d7f0));
let fg_muted = Color('#0d1638').alpha(0.6);
let blue = Color(CSSVar('--ribbon-color', #457b9d));
let font = 'Helvetica, Arial, sans-serif';

define PathLayer('bg') ${
  fill: bg_color;
  stroke: none;
}
define PathLayer('ribbon') ${
  fill: blue;
  fill-opacity: 0.45;
  stroke: blue;
  stroke-width: 1.5;
}
define PathLayer('rail') ${
  stroke: fg_muted;
  stroke-width: 1;
  fill: none;
  stroke-dasharray: "3 4";
}
define TextLayer('eyebrow') ${
  font-family: font;
  font-size: 8;
  font-weight: 700;
  letter-spacing: 3;
  fill: fg_muted;
}

layer('bg').apply {
  rect(0, 0, 520, 220);
}

let L = 400;
let railY = 124;
let spine = @{
  h 400
};

let ribbon = spine.compoundVariableOffset() {|go, pb|
  go.startCap(Cap.round());
  go.stop(4%,
      8,
      CurveContinuity.G2,
      -8,
      CurveContinuity.G2);
  go.stop(32%,
      34,
      CurveContinuity.G2,
      -26,
      CurveContinuity.G2);
  go.stop(60%,
      18,
      CurveContinuity.G2,
      -12,
      CurveContinuity.G2);
  go.stop(96%,
      10,
      CurveContinuity.G2,
      -10,
      CurveContinuity.G2);
  go.endCap(Cap.tapered(30, CurveContinuity.G2));
};

layer('eyebrow').apply {
  text(60, 48)`TWO PROFILES + CAPS = A CLOSED RIBBON`;
}
layer('ribbon').apply {
  ribbon.drawTo(calc(60 + L * 0.04), calc(railY - 8));
}
// Rail drawn last so it reads through the translucent fill.
layer('rail').apply {
  spine.drawTo(60, railY);
}
