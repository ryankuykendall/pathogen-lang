define ViewBox(0, 0, 960, 720);
// OKLCH Palette-Building Schematic
//
// A reactive companion figure to a process for building accessible UI
// color palettes in OKLCH. Six anchor CSSVars (--anchor-1 .. --anchor-6)
// drive every downstream swatch via Color.palette() + CSS relative color
// expressions. A seventh CSSVar (--bg) drives the page background; all
// foreground text auto-selects a contrasting tone by reading --bg's
// lightness at render time. Edit any CSSVar in DevTools to reflow the
// whole figure.

// ─────────────────────────────────────────────────────────────────
// Reactive background + auto-contrasting foreground ink
// ─────────────────────────────────────────────────────────────────

// --bg registered as a proper <color> @property so mini-workspace's
// color picker auto-detects it alongside --anchor-1..6.
let bg_color = Color(CSSVar('--bg', #0f172a));

// CSS relative-color trick: read --bg's lightness, amplify the distance
// from mid-grey (0.5) by 1000x. Browsers clamp L to [0,1], so any L > 0.5
// yields L=0 (black ink) and any L < 0.5 yields L=1 (white ink). C=0, H=0
// give a neutral achromatic tone that won't fight the palette colors.
let fg_auto = Color('#f0e8c8');
let fg_muted = Color('#f0e8c8').alpha(0.65);
let fg_dim = Color('#f0e8c8').alpha(0.45);
let stroke_fg = Color('#f0e8c8').alpha(0.25);

// ─────────────────────────────────────────────────────────────────
// Group scaffolding — root diagram + one group per section
// ─────────────────────────────────────────────────────────────────

define GroupLayer('diagram') ${}
define GroupLayer('header') ${}
define GroupLayer('section-1') ${}
define GroupLayer('section-2') ${}
define GroupLayer('section-3') ${}
define GroupLayer('section-5') ${}
define GroupLayer('section-7') ${}

// ─────────────────────────────────────────────────────────────────
// Background + title
// ─────────────────────────────────────────────────────────────────

let bg = PathLayer('bg') ${
  fill: bg_color;
  stroke: none;
};
bg.apply {
  rect(0, 0, 960, 720);
}
layer('diagram').append(layer('bg'));

let title = TextLayer('title') ${
  font-family: system-ui, sans-serif;
  font-size: 15;
  font-weight: 600;
  fill: fg_auto;
  text-anchor: start;
};
title.apply {
  text(30, 30)`OKLCH palette-building schematic`;
}

let subtitle = TextLayer('subtitle') ${
  font-family: system-ui, sans-serif;
  font-size: 10;
  fill: fg_muted;
  text-anchor: start;
};
subtitle.apply {
  text(30, 48)`Six anchor CSSVars + one --bg drive every swatch — edit any of them in DevTools to reflow the pipeline.`;
}

layer('header').append(layer('title'), layer('subtitle'));
layer('diagram').append(layer('header'));

// ─────────────────────────────────────────────────────────────────
// Reactive anchor colors + per-anchor 9-stop palettes
// ─────────────────────────────────────────────────────────────────

let red = Color(CSSVar('--anchor-1', oklch(0.55 0.16 27)));
let amber = Color(CSSVar('--anchor-2', oklch(0.55 0.16 80)));
let green = Color(CSSVar('--anchor-3', oklch(0.55 0.16 140)));
let teal = Color(CSSVar('--anchor-4', oklch(0.55 0.16 200)));
let blue = Color(CSSVar('--anchor-5', oklch(0.55 0.16 260)));
let purple = Color(CSSVar('--anchor-6', oklch(0.55 0.16 320)));

let anchors = [
  red,
  amber,
  green,
  teal,
  blue,
  purple,
];
let anchor_names = [
  'red',
  'amber',
  'green',
  'teal',
  'blue',
  'purple',
];
let anchor_hues = [
  '27°',
  '80°',
  '140°',
  '200°',
  '260°',
  '320°',
];

// Build the 9-stop palette once per anchor. Color.palette(c, 9) pins
// absolute L values across stops (0.15 .. 0.95) while inheriting C/H
// from the source — every pipeline stage below is a slice of these.
let ramp_red = Color.palette(red, 9);
let ramp_amber = Color.palette(amber, 9);
let ramp_green = Color.palette(green, 9);
let ramp_teal = Color.palette(teal, 9);
let ramp_blue = Color.palette(blue, 9);
let ramp_purple = Color.palette(purple, 9);

let ramps = [
  ramp_red,
  ramp_amber,
  ramp_green,
  ramp_teal,
  ramp_blue,
  ramp_purple,
];

// Shared pipeline column layout
let pipe_start_x = 170;
let pipe_gap = 34;
let pipe_w = 100;
let pipe_h = 52;

// ─────────────────────────────────────────────────────────────────
// 1. Choose originals — six anchor hues
// ─────────────────────────────────────────────────────────────────

let s1_title = TextLayer('s1-title') ${
  font-family: system-ui, sans-serif;
  font-size: 12;
  font-weight: 600;
  fill: fg_auto;
  text-anchor: start;
};
s1_title.apply {
  text(30, 88)`1. Choose originals`;
}

let s1_sub = TextLayer('s1-sub') ${
  font-family: system-ui, sans-serif;
  font-size: 9;
  fill: fg_muted;
  text-anchor: start;
};
s1_sub.apply {
  text(30, 104)`six anchor hues`;
}

layer('section-1').append(layer('s1-title'), layer('s1-sub'));

for ([c, i] in anchors) {
  let x = calc(pipe_start_x + i * (pipe_w + pipe_gap));
  let tile_name = `a_${i}`;
  let tile = PathLayer(tile_name) ${
    fill: c;
    stroke: stroke_fg;
    stroke-width: 0.5;
  };
  tile.apply {
    roundRect(x,
        88,
        pipe_w,
        pipe_h,
        4);
  }
  layer('section-1').append(layer(tile_name));
}

let anchor_name_layer = TextLayer('anchor-names') ${
  font-family: monospace;
  font-size: 8;
  fill: fg_muted;
  text-anchor: middle;
};
for ([name, i] in anchor_names) {
  let cx = calc(pipe_start_x + i * (pipe_w + pipe_gap) + pipe_w / 2);
  anchor_name_layer.apply {
    text(cx, 154)`${name}`;
  }
}

let anchor_hue_layer = TextLayer('anchor-hues') ${
  font-family: monospace;
  font-size: 8;
  fill: fg_dim;
  text-anchor: middle;
};
for ([hue, i] in anchor_hues) {
  let cx = calc(pipe_start_x + i * (pipe_w + pipe_gap) + pipe_w / 2);
  anchor_hue_layer.apply {
    text(cx, 166)`${hue}`;
  }
}

layer('section-1').append(layer('anchor-names'), layer('anchor-hues'));
layer('diagram').append(layer('section-1'));

// ─────────────────────────────────────────────────────────────────
// 2. Normalize luminance — ramp[4] pins absolute L = 0.55
// ─────────────────────────────────────────────────────────────────

let s2_title = TextLayer('s2-title') ${
  font-family: system-ui, sans-serif;
  font-size: 12;
  font-weight: 600;
  fill: fg_auto;
  text-anchor: start;
};
s2_title.apply {
  text(30, 198)`2. Normalize luminance`;
}

let s2_sub = TextLayer('s2-sub') ${
  font-family: system-ui, sans-serif;
  font-size: 9;
  fill: fg_muted;
  text-anchor: start;
};
s2_sub.apply {
  text(30, 214)`ramp[4] — absolute L = 0.55`;
}

layer('section-2').append(layer('s2-title'), layer('s2-sub'));

for ([r, i] in ramps) {
  let x = calc(pipe_start_x + i * (pipe_w + pipe_gap));
  let c = r[4];
  let tile_name = `n_${i}`;
  let tile = PathLayer(tile_name) ${
    fill: c;
    stroke: stroke_fg;
    stroke-width: 0.5;
  };
  tile.apply {
    roundRect(x,
        198,
        pipe_w,
        pipe_h,
        4);
  }
  layer('section-2').append(layer(tile_name));
}

layer('diagram').append(layer('section-2'));

// ─────────────────────────────────────────────────────────────────
// 3. Increase luminance — ramp[6] pins absolute L = 0.75
// ─────────────────────────────────────────────────────────────────

let s3_title = TextLayer('s3-title') ${
  font-family: system-ui, sans-serif;
  font-size: 12;
  font-weight: 600;
  fill: fg_auto;
  text-anchor: start;
};
s3_title.apply {
  text(30, 296)`3. Increase luminance`;
}

let s3_sub = TextLayer('s3-sub') ${
  font-family: system-ui, sans-serif;
  font-size: 9;
  fill: fg_muted;
  text-anchor: start;
};
s3_sub.apply {
  text(30, 312)`ramp[6] — absolute L = 0.75`;
}

layer('section-3').append(layer('s3-title'), layer('s3-sub'));

for ([r, i] in ramps) {
  let x = calc(pipe_start_x + i * (pipe_w + pipe_gap));
  let c = r[6];
  let tile_name = `l_${i}`;
  let tile = PathLayer(tile_name) ${
    fill: c;
    stroke: stroke_fg;
    stroke-width: 0.5;
  };
  tile.apply {
    roundRect(x,
        296,
        pipe_w,
        pipe_h,
        4);
  }
  layer('section-3').append(layer(tile_name));
}

layer('diagram').append(layer('section-3'));

// ─────────────────────────────────────────────────────────────────
// 5. Build ramps — Color.palette(anchor, 9)
// ─────────────────────────────────────────────────────────────────

let s5_title = TextLayer('s5-title') ${
  font-family: system-ui, sans-serif;
  font-size: 12;
  font-weight: 600;
  fill: fg_auto;
  text-anchor: start;
};
s5_title.apply {
  text(30, 394)`5. Build ramps`;
}

let s5_sub = TextLayer('s5-sub') ${
  font-family: system-ui, sans-serif;
  font-size: 9;
  fill: fg_muted;
  text-anchor: start;
};
s5_sub.apply {
  text(30, 410)`Color.palette(anchor, 9) — L distributed 0.15 … 0.95`;
}

layer('section-5').append(layer('s5-title'), layer('s5-sub'));

let grid_start_x = 160;
let grid_cell_w = 82;
let grid_cell_gap = 4;
let grid_row_h = 28;
let grid_row_gap = 2;
let grid_top = 432;

let stop_labels = [
  '100',
  '200',
  '300',
  '400',
  '500',
  '600',
  '700',
  '800',
  '900',
];

let grid_col_label = TextLayer('grid-col') ${
  font-family: monospace;
  font-size: 8;
  fill: fg_dim;
  text-anchor: middle;
};
for ([lbl, i] in stop_labels) {
  let cx = calc(grid_start_x + i * (grid_cell_w + grid_cell_gap) + grid_cell_w / 2);
  grid_col_label.apply {
    text(cx, 424)`${lbl}`;
  }
}

let grid_row_label = TextLayer('grid-row') ${
  font-family: monospace;
  font-size: 9;
  fill: fg_muted;
  text-anchor: end;
};

for ([r, ri] in ramps) {
  let row_y = calc(grid_top + ri * (grid_row_h + grid_row_gap));
  let row_name = anchor_names[ri];
  let label_y = calc(row_y + grid_row_h / 2 + 3);
  grid_row_label.apply {
    text(150, label_y)`${row_name}`;
  }

  for ([c, ci] in r) {
    let cell_x = calc(grid_start_x + ci * (grid_cell_w + grid_cell_gap));
    let cell_name = `g_${ri}_${ci}`;
    let cell = PathLayer(cell_name) ${
      fill: c;
      stroke: stroke_fg;
      stroke-width: 0.3;
    };
    cell.apply {
      roundRect(cell_x,
          row_y,
          grid_cell_w,
          grid_row_h,
          2);
    }
    layer('section-5').append(layer(cell_name));
  }
}


layer('section-5').append(layer('grid-col'), layer('grid-row'));

// Caption about chroma — lives inside section-5
let caption = TextLayer('caption') ${
  font-family: system-ui, sans-serif;
  font-size: 9;
  font-style: italic;
  fill: fg_dim;
  text-anchor: start;
};
caption.apply {
  text(160, 625)`Chroma stays tied to the authored anchor — per-color manual tweaks (e.g., a red pullback) are out of scope for this schematic.`;
}
layer('section-5').append(layer('caption'));

layer('diagram').append(layer('section-5'));

// ─────────────────────────────────────────────────────────────────
// 7. WCAG contrasts — stated as targets (live values set the verdict)
// ─────────────────────────────────────────────────────────────────

let s7_title = TextLayer('s7-title') ${
  font-family: system-ui, sans-serif;
  font-size: 12;
  font-weight: 600;
  fill: fg_auto;
  text-anchor: start;
};
s7_title.apply {
  text(30, 640)`7. WCAG contrasts`;
}

let s7_sub = TextLayer('s7-sub') ${
  font-family: system-ui, sans-serif;
  font-size: 9;
  fill: fg_muted;
  text-anchor: start;
};
s7_sub.apply {
  text(30, 654)`targets only — verdicts depend on live CSSVar values`;
}

layer('section-7').append(layer('s7-title'), layer('s7-sub'));

let wcag_pair_start_x = 170;
let wcag_pair_w = 230;
let wcag_pair_gap = 25;
let wcag_y = 662;
let wcag_tile = 32;

let wcag_label = TextLayer('wcag-label') ${
  font-family: system-ui, sans-serif;
  font-size: 9;
  font-weight: 600;
  fill: fg_auto;
  text-anchor: start;
};
let wcag_sub = TextLayer('wcag-sub') ${
  font-family: monospace;
  font-size: 8;
  fill: fg_muted;
  text-anchor: start;
};

// Three callouts span different anchors so editing several --anchor-N
// values will each update at least one contrast pair.

// Callout 1 · green[2] vs white — target AA large
let pair1_x = wcag_pair_start_x;
let tile_a1 = PathLayer('wa1') ${
  fill: ramp_green[2];
  stroke: stroke_fg;
  stroke-width: 0.5;
};
tile_a1.apply {
  roundRect(pair1_x,
      wcag_y,
      wcag_tile,
      wcag_tile,
      4);
}
let tile_b1 = PathLayer('wb1') ${
  fill: #ffffff;
  stroke: stroke_fg;
  stroke-width: 0.5;
};
tile_b1.apply {
  roundRect(calc(pair1_x + wcag_tile + 4),
      wcag_y,
      wcag_tile,
      wcag_tile,
      4);
}
wcag_label.apply {
  text(calc(pair1_x + 2 * wcag_tile + 14), calc(wcag_y + 13))`green[2] · white`;
}
wcag_sub.apply {
  text(calc(pair1_x + 2 * wcag_tile + 14), calc(wcag_y + 27))`target: AA large`;
}

// Callout 2 · blue[0] vs blue[7] — target AAA large
let pair2_x = calc(wcag_pair_start_x + wcag_pair_w + wcag_pair_gap);
let tile_a2 = PathLayer('wa2') ${
  fill: ramp_blue[0];
  stroke: stroke_fg;
  stroke-width: 0.5;
};
tile_a2.apply {
  roundRect(pair2_x,
      wcag_y,
      wcag_tile,
      wcag_tile,
      4);
}
let tile_b2 = PathLayer('wb2') ${
  fill: ramp_blue[7];
  stroke: stroke_fg;
  stroke-width: 0.5;
};
tile_b2.apply {
  roundRect(calc(pair2_x + wcag_tile + 4),
      wcag_y,
      wcag_tile,
      wcag_tile,
      4);
}
wcag_label.apply {
  text(calc(pair2_x + 2 * wcag_tile + 14), calc(wcag_y + 13))`blue[0] · blue[7]`;
}
wcag_sub.apply {
  text(calc(pair2_x + 2 * wcag_tile + 14), calc(wcag_y + 27))`target: AAA large`;
}

// Callout 3 · purple[1] vs purple[7] — target AAA large
let pair3_x = calc(wcag_pair_start_x + 2 * (wcag_pair_w + wcag_pair_gap));
let tile_a3 = PathLayer('wa3') ${
  fill: ramp_purple[1];
  stroke: stroke_fg;
  stroke-width: 0.5;
};
tile_a3.apply {
  roundRect(pair3_x,
      wcag_y,
      wcag_tile,
      wcag_tile,
      4);
}
let tile_b3 = PathLayer('wb3') ${
  fill: ramp_purple[7];
  stroke: stroke_fg;
  stroke-width: 0.5;
};
tile_b3.apply {
  roundRect(calc(pair3_x + wcag_tile + 4),
      wcag_y,
      wcag_tile,
      wcag_tile,
      4);
}
wcag_label.apply {
  text(calc(pair3_x + 2 * wcag_tile + 14), calc(wcag_y + 13))`purple[1] · purple[7]`;
}
wcag_sub.apply {
  text(calc(pair3_x + 2 * wcag_tile + 14), calc(wcag_y + 27))`target: AAA large`;
}

layer('section-7').append(layer('wa1'),
    layer('wb1'),
    layer('wa2'),
    layer('wb2'),
    layer('wa3'),
    layer('wb3'),
    layer('wcag-label'),
    layer('wcag-sub'));
layer('diagram').append(layer('section-7'));
