// viewBox="0 0 400 200"
// Hero: one line of Pathogen — five SVG filter primitives in the output.

let bg = PathLayer('bg') ${ fill: oklch(95% 0.02 80); stroke: none; };
bg.apply { rect(0, 0, 400, 200); }

// The one-liner: define a filter, name it, use it.
let grain = NoiseFilter() {|f| f.style = NoiseFilterStyle.Grain; };

let disc = PathLayer('disc') ${
  fill: oklch(70% 0.20 30);
  stroke: none;
  filter: grain;
};
disc.apply { circle(200, 100, 70); }
