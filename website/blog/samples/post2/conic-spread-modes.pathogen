define ViewBox(0, 0, 540, 400);
// Conic Spread Modes — Clamp / Repeat / Transparent
// How partial sweeps handle the unfilled arc

// --- Gradients (90°→270°, half-sweep) ---

let clamp_grad = ConicGradient('clamp-grad', 110, 180) {|g|
  g.stop(0,    Color('#059669'));
  g.stop(0.4,  Color('#fbbf24'));
  g.stop(1,    Color('#dc2626'));
};
clamp_grad.from = 90deg;
clamp_grad.to = 270deg;
clamp_grad.spread = 'clamp';
clamp_grad.interpolation = 'oklch';

let repeat_grad = ConicGradient('repeat-grad', 270, 180) {|g|
  g.stop(0,    Color('#059669'));
  g.stop(0.4,  Color('#fbbf24'));
  g.stop(1,    Color('#dc2626'));
};
repeat_grad.from = 90deg;
repeat_grad.to = 270deg;
repeat_grad.spread = 'repeat';
repeat_grad.interpolation = 'oklch';

let trans_grad = ConicGradient('trans-grad', 430, 180) {|g|
  g.stop(0,    Color('#059669'));
  g.stop(0.4,  Color('#fbbf24'));
  g.stop(1,    Color('#dc2626'));
};
trans_grad.from = 90deg;
trans_grad.to = 270deg;
trans_grad.spread = 'transparent';
trans_grad.interpolation = 'oklch';

// --- Background ---

let bg = PathLayer('bg') #{ fill: #111118; stroke: none; };
bg.apply { rect(0, 0, 540, 400); }

// --- Checkerboard behind transparent (to show transparency) ---

let checks = PathLayer('checks') #{ fill: #1e1e2a; stroke: none; };
checks.apply {
  rect(398, 148, 16, 16); rect(430, 148, 16, 16);
  rect(414, 164, 16, 16); rect(446, 164, 16, 16);
  rect(398, 180, 16, 16); rect(430, 180, 16, 16);
  rect(414, 196, 16, 16); rect(446, 196, 16, 16);
}

// --- Gradient circles ---

let c1 = PathLayer('c-clamp') #{ fill: clamp_grad; stroke: #333; stroke-width: 1; };
c1.apply { circle(110, 180, 80); closePath(); }

let c2 = PathLayer('c-repeat') #{ fill: repeat_grad; stroke: #333; stroke-width: 1; };
c2.apply { circle(270, 180, 80); closePath(); }

let c3 = PathLayer('c-trans') #{ fill: trans_grad; stroke: #333; stroke-width: 1; };
c3.apply { circle(430, 180, 80); closePath(); }

// --- Arc range indicators ---

let arcs = PathLayer('arc-lines') #{ fill: none; stroke: #ffffff44; stroke-width: 1; stroke-dasharray: 3 3; };
arcs.apply {
  // Vertical lines at 90° (top) and 270° (bottom) for each circle
  line(110, 92, 110, 98);   line(110, 262, 110, 268);
  line(270, 92, 270, 98);   line(270, 262, 270, 268);
  line(430, 92, 430, 98);   line(430, 262, 430, 268);
}

// --- Labels ---

let labels = TextLayer('labels') #{
  font-family: system-ui, sans-serif;
  font-size: 14;
  fill: #ddd;
  text-anchor: middle;
  font-weight: bold;
};
labels.apply {
  text(110, 292)`clamp`
  text(270, 292)`repeat`
  text(430, 292)`transparent`
}

let desc = TextLayer('desc') #{
  font-family: monospace;
  font-size: 9;
  fill: #777;
  text-anchor: middle;
};
desc.apply {
  text(110, 308)`first/last colors fill gap`
  text(270, 308)`gradient repeats in gap`
  text(430, 308)`gap area is transparent`
}

let title = TextLayer('title') #{
  font-family: system-ui, sans-serif;
  font-size: 15;
  fill: #bbb;
  text-anchor: middle;
  font-weight: bold;
};
title.apply {
  text(270, 50)`Spread Modes on Partial Sweep (90° → 270°)`
}

let angle_note = TextLayer('angle-note') #{
  font-family: monospace;
  font-size: 9;
  fill: #555;
  text-anchor: middle;
};
angle_note.apply {
  text(270, 68)`Left half: gradient renders | Right half: spread mode fills the gap`
}

// --- Scene ---

let scene = GroupLayer('scene') #{};
scene.append(bg, checks, c1, c2, c3, arcs, labels, desc, title, angle_note);
