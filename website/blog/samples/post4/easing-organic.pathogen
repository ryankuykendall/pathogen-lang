// viewBox="0 0 550 350"
// Easing Modes — Organic Geometry Edition
// Same 5 easing curves, but with irregular blob contours instead of circles

// --- Organic contour shapes using relative commands ---

let blob_outer = @{
  m 0 0
  c 90 -80 250 -45 310 0
  c 60 55 40 200 -20 270
  c -80 80 -225 50 -290 -20
  c -55 -80 -65 -185 0 -250
  z
};

let blob_inner = @{
  m 0 0
  c 35 -35 100 -22 125 10
  c 25 35 10 100 -25 125
  c -38 20 -86 0 -100 -35
  c -22 -38 -28 -70 0 -100
  z
};

// --- Five gradients at proper resolution ---

let t1 = TopoGradient('org-0', 400, 400) {|g|
  g.contour(blob_outer.project(50, 120), 0.25, Color('#6366f1'));
  g.contour(blob_inner.project(115, 145), 0.7, Color('#ec4899'));
};
t1.baseColor = Color('#0f0f1a');
t1.easing = 'linear';
t1.interpolation = 'oklch';

let t2 = TopoGradient('org-1', 400, 400) {|g|
  g.contour(blob_outer.project(50, 120), 0.25, Color('#6366f1'));
  g.contour(blob_inner.project(115, 145), 0.7, Color('#ec4899'));
};
t2.baseColor = Color('#0f0f1a');
t2.easing = 'smoothstep';
t2.interpolation = 'oklch';

let t3 = TopoGradient('org-2', 400, 400) {|g|
  g.contour(blob_outer.project(50, 120), 0.25, Color('#6366f1'));
  g.contour(blob_inner.project(115, 145), 0.7, Color('#ec4899'));
};
t3.baseColor = Color('#0f0f1a');
t3.easing = 'ease-in';
t3.interpolation = 'oklch';

let t4 = TopoGradient('org-3', 400, 400) {|g|
  g.contour(blob_outer.project(50, 120), 0.25, Color('#6366f1'));
  g.contour(blob_inner.project(115, 145), 0.7, Color('#ec4899'));
};
t4.baseColor = Color('#0f0f1a');
t4.easing = 'ease-out';
t4.interpolation = 'oklch';

let t5 = TopoGradient('org-4', 400, 400) {|g|
  g.contour(blob_outer.project(50, 120), 0.25, Color('#6366f1'));
  g.contour(blob_inner.project(115, 145), 0.7, Color('#ec4899'));
};
t5.baseColor = Color('#0f0f1a');
t5.easing = 'ease-in-out';
t5.interpolation = 'oklch';

// --- Background ---

let bg = PathLayer('bg') ${ fill: #111118; stroke: none; };
bg.apply { rect(0, 0, 550, 350); }

// --- Fills ---

let p1 = PathLayer('p1') ${ fill: t1; stroke: #333; stroke-width: 1; };
p1.apply { roundRect(15, 60, 90, 90, 6); }

let p2 = PathLayer('p2') ${ fill: t2; stroke: #333; stroke-width: 1; };
p2.apply { roundRect(120, 60, 90, 90, 6); }

let p3 = PathLayer('p3') ${ fill: t3; stroke: #333; stroke-width: 1; };
p3.apply { roundRect(225, 60, 90, 90, 6); }

let p4 = PathLayer('p4') ${ fill: t4; stroke: #333; stroke-width: 1; };
p4.apply { roundRect(330, 60, 90, 90, 6); }

let p5 = PathLayer('p5') ${ fill: t5; stroke: #333; stroke-width: 1; };
p5.apply { roundRect(435, 60, 90, 90, 6); }

// --- Labels ---

let labels = TextLayer('labels') ${
  font-family: system-ui, sans-serif;
  font-size: 11;
  fill: #ddd;
  text-anchor: middle;
  font-weight: bold;
};
labels.apply {
  text(60, 48)`linear`
  text(165, 48)`smoothstep`
  text(270, 48)`ease-in`
  text(375, 48)`ease-out`
  text(480, 48)`ease-in-out`
}

let desc = TextLayer('desc') ${
  font-family: monospace;
  font-size: 8;
  fill: #666;
  text-anchor: middle;
};
desc.apply {
  text(60, 168)`uniform`
  text(165, 168)`smooth S-curve`
  text(270, 168)`slow start`
  text(375, 168)`slow end`
  text(480, 168)`slow both`
}

let title = TextLayer('title') ${
  font-family: system-ui, sans-serif;
  font-size: 14;
  fill: #999;
  text-anchor: middle;
};
title.apply {
  text(275, 240)`Easing with Organic Contours — Irregular Blob Geometry`
}

// --- Scene ---

let scene = GroupLayer('scene') ${};
scene.append(bg, p1, p2, p3, p4, p5, labels, desc, title)
