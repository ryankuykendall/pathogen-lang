// Pathogen Language Grammar — Lezer LR Parser
// Single source of truth for Pathogen syntax, powering both the compiler
// (via CST-to-AST conversion) and the playground editor (CodeMirror 6).

@top Program { statement* }

@precedence {
  member @left,
  call @left,
  prefix,
  times @left,
  plus @left,
  compare @left,
  merge @left,
  equality @left,
  and @left,
  or @left,
  ternary @right,
  assign @right
}

// ─── Statements ────────────────────────────────────────────────

statement {
  Comment |
  FontDirective |
  LayerDefinition |
  LayerApplyBlock |
  TextStatement |
  EnumDefinition |
  LetDeclaration |
  ForLoop |
  ForEachLoop |
  IfStatement |
  FunctionDefinition |
  ReturnStatement |
  PathCommand |
  ExpressionStatement
}

// Note: Assignment, IndexedAssignment, MemberAssignment are handled
// within ExpressionStatement. The AST builder distinguishes them by
// checking if the expression ends with "= expr ;".

LetDeclaration {
  kw<"let"> (ArrayDestructure | ObjectDestructure | VariableName) "=" expression ";"
}

ForLoop {
  kw<"for"> "(" VariableName kw<"in"> expression RangeOp expression ")" Block
}

ForEachLoop {
  kw<"for"> "(" (ForEachDestructure | VariableName) kw<"in"> expression ")" Block
}

ForEachDestructure {
  "[" VariableName "," VariableName "]"
}

IfStatement {
  kw<"if"> "(" expression ")" Block ElseClause?
}

ElseClause {
  kw<"else"> (IfStatement | Block)
}

FunctionDefinition {
  kw<"fn"> VariableName "(" commaSep<VariableName> ")" Block
}

ReturnStatement {
  kw<"return"> expression ";"
}

EnumDefinition {
  kw<"enum"> VariableName "{" EnumMember ("," EnumMember)* ","? "}"
}

EnumMember {
  VariableName ("=" expression)?
}

LayerDefinition {
  kw<"define"> kw<"default">? LayerType "(" expression ")" expression
}

LayerApplyBlock {
  kw<"layer"> "(" expression ")" ~layerDot "." kw<"apply"> Block
}

TextStatement {
  kw<"text"> "(" expression "," expression ("," expression ("," expression)?)? ")"
  (TemplateLiteral | TextBlock)
}

TextBlock {
  "{" textBodyItem* "}"
}

textBodyItem {
  TspanStatement |
  TemplateLiteral |
  TextForLoop |
  TextForEachLoop |
  TextIfStatement |
  LetDeclaration
}

TspanStatement {
  kw<"tspan"> "(" expression ("," expression)* ")" TemplateLiteral |
  kw<"tspan"> "(" ")" TemplateLiteral
}

TextForLoop {
  kw<"for"> "(" VariableName kw<"in"> expression RangeOp expression ")" "{" textBodyItem* "}"
}

TextForEachLoop {
  kw<"for"> "(" (ForEachDestructure | VariableName) kw<"in"> expression ")" "{" textBodyItem* "}"
}

TextIfStatement {
  kw<"if"> "(" expression ")" "{" textBodyItem* "}" (kw<"else"> (TextIfStatement | "{" textBodyItem* "}"))?
}

FontDirective {
  fontDirectiveKw String ~fontWeight Number ";"? |
  fontDirectiveKw String ~fontWeight ";"?
}

// Path commands: always greedy when args are available.
// Z/z take no args; all others take at least one.
PathCommand {
  pathCmd PathArgs |
  pathCmdZ
}

pathCmd[@name=PathCommandLetter] {
  @extend[@name=PathCommandLetter]<Identifier, "M"> |
  @extend[@name=PathCommandLetter]<Identifier, "m"> |
  @extend[@name=PathCommandLetter]<Identifier, "L"> |
  @extend[@name=PathCommandLetter]<Identifier, "l"> |
  @extend[@name=PathCommandLetter]<Identifier, "H"> |
  @extend[@name=PathCommandLetter]<Identifier, "h"> |
  @extend[@name=PathCommandLetter]<Identifier, "V"> |
  @extend[@name=PathCommandLetter]<Identifier, "v"> |
  @extend[@name=PathCommandLetter]<Identifier, "C"> |
  @extend[@name=PathCommandLetter]<Identifier, "c"> |
  @extend[@name=PathCommandLetter]<Identifier, "S"> |
  @extend[@name=PathCommandLetter]<Identifier, "s"> |
  @extend[@name=PathCommandLetter]<Identifier, "Q"> |
  @extend[@name=PathCommandLetter]<Identifier, "q"> |
  @extend[@name=PathCommandLetter]<Identifier, "T"> |
  @extend[@name=PathCommandLetter]<Identifier, "t"> |
  @extend[@name=PathCommandLetter]<Identifier, "A"> |
  @extend[@name=PathCommandLetter]<Identifier, "a">
}

pathCmdZ[@name=PathCommandLetter] {
  @extend[@name=PathCommandLetter]<Identifier, "Z"> |
  @extend[@name=PathCommandLetter]<Identifier, "z">
}

// PathArgs is a single opaque token consumed by an external tokenizer.
// The tokenizer greedily consumes numbers, identifiers, calc(), booleans,
// and member/index/call chains until hitting a statement boundary
// (keyword, path command letter, EOF, or closing brace).
@external tokens pathArgsTokenizer from "./path-args-tokenizer" {
  PathArgs
}

ExpressionStatement {
  expression ("=" expression)? ";"
}

Block {
  "{" statement* "}"
}

// ─── Expressions ───────────────────────────────────────────────

expression {
  TernaryExpression |
  BinaryExpression |
  UnaryExpression |
  postfixExpression
}

TernaryExpression {
  expression !ternary "?" expression ":" expression
}

BinaryExpression {
  expression !or "||" expression |
  expression !and "&&" expression |
  expression !equality ("==" | "!=") expression |
  expression !compare ("<=" | ">=" | "<" | ">") expression |
  expression !merge "<<" expression |
  expression !plus ("+" | "-") expression |
  expression !times ("*" | "/" | "%") expression
}

UnaryExpression {
  !prefix ("-" | "!") expression
}

postfixExpression {
  primaryExpression (
    !call ArgList TrailingBlock? |
    !member "." Identifier !call ArgList TrailingBlock? |
    !member "." Identifier TrailingBlock |
    !member "." Identifier |
    !member "[" expression "]"
  )*
}

ArgList {
  "(" commaSep<expression> ")"
}

primaryExpression {
  Number |
  String |
  TemplateLiteral |
  BooleanLiteral |
  NullLiteral |
  ColorLiteral |
  CSSColorLiteral |
  ArrayLiteral |
  ObjectLiteral |
  StyleBlockLiteral |
  PathBlockExpression |
  TextBlockExpression |
  CalcExpression |
  LayerConstructor |
  LayerCallExpression |
  Identifier |
  ParenExpression
}

LayerCallExpression {
  kw<"layer"> "(" expression ")" ~layerDot
}

ParenExpression { "(" expression ")" }

TrailingBlock {
  "{" "|" VariableName ("," VariableName)* "|" statement* "}"
}

CalcExpression {
  kw<"calc"> "(" expression ")"
}

ArrayLiteral {
  "[" (arrayElement ("," arrayElement)* ","?)? "]"
}

arrayElement {
  SpreadElement | expression
}

SpreadElement {
  "..." expression
}

ObjectLiteral {
  "{" (objectElement ("," objectElement)* ","?)? "}"
}

objectElement {
  SpreadElement | ObjectProperty
}

ObjectProperty {
  (Identifier | String) ":" expression
}

StyleBlockLiteral {
  styleBlockOpen StyleContent? "}"
}

PathBlockExpression {
  pathBlockOpen statement* "}"
}

TextBlockExpression {
  textBlockOpen statement* "}"
}

LayerConstructor {
  LayerType "(" expression ")" ~layerStyle StyleBlockLiteral |
  LayerType "(" expression ")" ~layerStyle
}

// ─── Destructuring ─────────────────────────────────────────────

ArrayDestructure {
  "[" VariableName ("," VariableName)* ("," "..." VariableName)? "]"
}

ObjectDestructure {
  "{" ObjectDestructureProp ("," ObjectDestructureProp)* ("," "..." VariableName)? "}"
}

ObjectDestructureProp {
  Identifier (":" VariableName)?
}

// ─── Template Literals ─────────────────────────────────────────

TemplateLiteral {
  templateStart (templateContent | TemplateInterpolation)* templateEnd
}

TemplateInterpolation {
  templateInterpStart expression templateInterpEnd
}

// ─── Helpers ───────────────────────────────────────────────────

commaSep<content> {
  (content ("," content)*)?
}

kw<term> { @specialize[@name={term}]<Identifier, term> }

VariableName { Identifier }

// ─── Tokens ────────────────────────────────────────────────────

@skip { whitespace | LineComment }

// LineComment is skipped (not preserved in tree). Comment nodes in statements
// are preserved for the annotated view. Both use "//" syntax — the parser
// tries Comment first (in statement position), LineComment handles the rest.

@tokens {
  whitespace { @whitespace+ }

  Comment { "//" ![\n]* }
  LineComment { "//" ![\n]* }

  @precedence { Comment, LineComment, "/" }

  // Numbers: no leading minus (unary minus at expression level).
  // Require at least one digit after decimal point to prevent matching "0." before ".." range.
  Number {
    (@digit+ "." @digit+ | "." @digit+ | @digit+) ("deg" | "rad" | "pi" | "%")?
  }

  String {
    "\"" (![\\\"\n] | "\\" _)* "\"" |
    "'" (![\\\'\n] | "\\" _)* "'"
  }

  ColorLiteral { "#" $[0-9a-fA-F]+ }

  CSSColorLiteral {
    ("rgb" | "rgba" | "hsl" | "hsla" | "hwb" | "lab" | "lch" | "oklab" | "oklch")
    "(" (![\)]* ) ")"
  }

  BooleanLiteral { "true" | "false" }

  NullLiteral { "null" }

  templateStart { "`" }
  templateEnd { "`" }
  templateContent { (![\`\\$] | "\\" _ | "$" ![\{])+ }
  templateInterpStart { "$" "{" }
  templateInterpEnd { "}" }

  Identifier { $[a-zA-Z_] $[a-zA-Z0-9_]* }

  // pathCommandLetter removed — handled via @specialize on Identifier

  LayerType { "PathLayer" | "TextLayer" | "GroupLayer" }

  RangeOp { ".." }

  styleBlockOpen { "$" "{" }
  pathBlockOpen { "@" "{" }
  textBlockOpen { "&" "{" }

  fontDirectiveKw { "@" "font" }

  StyleContent { ![}]+ }

  @precedence { "...", RangeOp, "." }
  @precedence { "||" }
  @precedence { "&&" }
  @precedence { "==", "!=" }
  @precedence { "<=", ">=", "<<" }
  @precedence { fontDirectiveKw, pathBlockOpen }
  @precedence { styleBlockOpen, templateInterpStart }
  @precedence { Number, "." }
  @precedence { BooleanLiteral, NullLiteral, LayerType, CSSColorLiteral, Identifier }
  @precedence { StyleContent, templateContent, LineComment, whitespace }
  @precedence { templateStart, templateContent, templateEnd }

  "(" ")" "[" "]" "{" "}" ";" "," ":" "?" "."
  "+" "-" "*" "/" "%" "!" "=" "<" ">" "|"
  "||" "&&" "==" "!=" "<=" ">=" "<<" "..."
}

@detectDelim

@external propSource pathogenHighlighting from "./highlight"
