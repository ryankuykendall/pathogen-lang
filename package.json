{
  "name": "pathogen-lang",
  "version": "0.8.0",
  "description": "Extended SVG path syntax with variables, expressions, control flow, and functions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.global.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pan-zoom": {
      "types": "./dist/pan-zoom.d.ts",
      "import": "./dist/pan-zoom.js",
      "require": "./dist/pan-zoom.cjs",
      "browser": "./dist/pan-zoom.global.js"
    }
  },
  "bin": {
    "pathogen": "./dist/cli.js",
    "pathogen-lang": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:completions": "tsx scripts/generate-completions.ts",
    "generate:style-parser": "lezer-generator src/parser/style.grammar --typeScript -o src/parser/style.generated.ts",
    "check:completions": "tsx scripts/generate-completions.ts --strict && git diff --exit-code src/language-services/completion-data.generated.ts",
    "build": "tsup",
    "build:docs": "tsx scripts/build-docs.ts",
    "build:blog": "tsx scripts/build-blog.ts",
    "new:blog": "tsx scripts/new-blog-post.ts",
    "build:playground": "tsx scripts/build-playground.ts",
    "dev:playground": "tsx scripts/build-playground.ts --watch",
    "typecheck:playground": "tsc -p playground/tsconfig.json",
    "build:website": "npm run build && npm run build:docs && npm run build:blog && tsx scripts/build-website.ts",
    "dev": "tsup --watch",
    "dev:website": "npm run kill:wrangler; PATHOGEN_API_BASE=http://localhost:8787 npm run build:website && npx wrangler pages dev public --port 3000 --persist-to=.wrangler/state",
    "dev:website:quick": "npm run kill:wrangler; npx wrangler pages dev public --port 3000 --persist-to=.wrangler/state",
    "dev:api": "cd api && npm run dev",
    "dev:stack": "concurrently -k -n web,api -c blue,magenta \"npm:dev:website\" \"npm:dev:api\"",
    "deploy:api": "cd api && npm run deploy",
    "kill:wrangler": "tsx scripts/kill-port.ts",
    "seed:dev": "tsx scripts/seed-dev-users.ts",
    "backfill:publication-state": "tsx scripts/backfill-publication-state.ts",
    "backfill:owner-handle": "tsx scripts/backfill-owner-handle.ts",
    "migrate:viewbox:dev": "tsx scripts/migrate-viewbox.ts --env=dev",
    "migrate:viewbox:prod": "tsx scripts/migrate-viewbox.ts --env=prod",
    "merge:wrangler-state": "tsx scripts/merge-wrangler-state.ts",
    "website:admin-token": "npm run build:website && tsx scripts/rotate-admin-token.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "security:audit": "vitest run tests/security/",
    "security:browser-audit": "tsx scripts/security-browser-audit.ts",
    "perf:panzoom": "tsx scripts/perf-pan-zoom-audit.ts",
    "perf:transform-probe": "tsx scripts/perf-transform-probe.ts",
    "perf:typing": "tsx scripts/perf-typing-audit.ts",
    "cli": "tsx src/cli.ts",
    "inspect:pdf": "tsx scripts/inspect-pdf.ts",
    "serve:bbwp": "tsx scripts/serve-bbwp.ts",
    "update:bbwp-index": "tsx scripts/update-bbwp-index.ts",
    "backfill:approval-svgs": "tsx scripts/backfill-approval-svgs.ts",
    "build:vscode": "tsx scripts/build-vscode-extension.ts",
    "build:vscode:install": "tsx scripts/build-vscode-extension.ts --install",
    "compile:bbwp": "tsx scripts/compile-bbwp.ts",
    "compile:samples": "tsx scripts/compile-samples.ts",
    "format:pathogen": "tsx scripts/format-pathogen.ts",
    "format:samples": "tsx scripts/format-samples.ts",
    "validate:samples": "tsx scripts/validate-samples.ts",
    "check-links": "tsx scripts/check-links.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "svg",
    "path",
    "preprocessor",
    "dsl"
  ],
  "workspaces": [
    "packages/pathogen-language-server"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@lezer/generator": "^1.8.0",
    "@types/node": "^24.13.3",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@webgpu/types": "^0.1.72",
    "commander": "^15.0.0",
    "concurrently": "^9.2.4",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "highlight.js": "^11.12.0",
    "jpeg-js": "^0.4.4",
    "jsdom": "^29.1.1",
    "marked": "^18.0.11",
    "marked-highlight": "^2.2.4",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "puppeteer": "^25.10.0",
    "ts-morph": "^28.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "hdr-color-input": "^0.4.4",
    "jspdf": "^4.2.1",
    "opentype.js": "^1.3.4",
    "svg2pdf.js": "^2.8.1",
    "tslib": "^2.8.1",
    "woff2-encoder": "^2.0.0"
  }
}
