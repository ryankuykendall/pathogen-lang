{
  "name": "svg-path-extended",
  "version": "0.1.0",
  "description": "Extended SVG path syntax with variables, expressions, control flow, and functions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.global.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "svg-path-extended": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:completions": "tsx scripts/generate-completions.ts",
    "build": "tsup",
    "build:docs": "tsx scripts/build-docs.ts",
    "build:blog": "tsx scripts/build-blog.ts",
    "new:blog": "tsx scripts/new-blog-post.ts",
    "build:playground": "tsx scripts/build-playground.ts",
    "dev:playground": "tsx scripts/build-playground.ts --watch",
    "typecheck:playground": "tsc -p playground/tsconfig.json",
    "build:website": "npm run build && npm run build:docs && npm run build:blog && tsx scripts/build-website.ts",
    "dev": "tsup --watch",
    "dev:website": "npm run kill:wrangler; npm run build:website && npx wrangler pages dev public --port 3000",
    "dev:website:quick": "npm run kill:wrangler; npx wrangler pages dev public --port 3000",
    "kill:wrangler": "tsx scripts/kill-port.ts",
    "website:admin-token": "npm run build:website && tsx scripts/rotate-admin-token.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "cli": "tsx src/cli.ts",
    "serve:bbwp": "tsx scripts/serve-bbwp.ts",
    "update:bbwp-index": "tsx scripts/update-bbwp-index.ts",
    "compile:bbwp": "tsx scripts/compile-bbwp.ts",
    "compile:samples": "tsx scripts/compile-samples.ts",
    "check-links": "tsx scripts/check-links.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "svg",
    "path",
    "preprocessor",
    "dsl"
  ],
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^9.39.4",
    "@lezer/generator": "^1.8.0",
    "@types/node": "^20.10.0",
    "@types/opentype.js": "^1.3.9",
    "@vitest/coverage-v8": "^1.6.1",
    "@webgpu/types": "^0.1.69",
    "commander": "^14.0.3",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.4",
    "eslint-config-airbnb-extended": "^3.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.0",
    "marked-highlight": "^2.2.3",
    "prettier": "^3.8.1",
    "puppeteer": "^24.38.0",
    "ts-morph": "^27.0.2",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "wrangler": "^4.69.0"
  },
  "dependencies": {
    "@lezer/common": "^1.5.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.8",
    "opentype.js": "^1.3.4",
    "tslib": "^2.8.1"
  }
}
