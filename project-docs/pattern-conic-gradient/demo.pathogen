// ═══════════════════════════════════════════════════════
// Phase 2b Demo: Pattern, ConicGradient, Reactive Colors
// ═══════════════════════════════════════════════════════

// ── Reactive color palette (tweak via CSS var panel) ──
let hot    = Color(CSSVar('--hot', '#e63946'));
let warm   = Color(CSSVar('--warm', '#f4a261'));
let cool   = Color(CSSVar('--cool', '#2a9d8f'));
let deep   = Color(CSSVar('--deep', '#264653'));
let cream  = Color(CSSVar('--cream', '#f4f1de'));

// ── Pattern: polka-dot tile ──────────────────────────
let dot = @{ circle(5, 5, 1.8) };
let polka = Pattern('polka', 0, 0, 10, 10) {|p|
  p.append(dot, ${ fill: deep; opacity: 0.15; });
};
polka.patternUnits = 'userSpaceOnUse';

// ── ConicGradient: full-revolution color wheel ───────
let wheel = ConicGradient('wheel', 50, 65) {|g|
  g.stop(0,    hot);
  g.stop(0.25, warm);
  g.stop(0.5,  cool);
  g.stop(0.75, deep);
  g.stop(1,    hot);
};
wheel.interpolation = 'oklch';
wheel.steps = 8;

// ── ConicGradient: gauge (270° partial sweep) ────────
let gauge = ConicGradient('gauge', 150, 65) {|g|
  g.stop(0,   cool);
  g.stop(0.5, warm);
  g.stop(1,   hot);
};
gauge.from = 135deg;
gauge.to = 405deg;
gauge.interpolation = 'oklch';
gauge.steps = 8;

// ── ConicGradient: spotlight band (30° sweep) ────────
let spot = ConicGradient('spot', 100, 155) {|g|
  g.stop(0,   Color('#000000').alpha(0));
  g.stop(0.5, cream);
  g.stop(1,   Color('#000000').alpha(0));
};
spot.from = -15deg;
spot.to = 15deg;
spot.spread = 'transparent';

// ═══════════════════════════════════════════════════════
//  Layers (back → front)
// ═══════════════════════════════════════════════════════

// Background
define PathLayer('bg') ${ fill: cream; stroke: none; }
layer('bg').apply { M 0 0 L 200 0 L 200 200 L 0 200 Z }

// Pattern overlay
define PathLayer('dots') ${ fill: polka; stroke: none; }
layer('dots').apply { M 0 0 L 200 0 L 200 200 L 0 200 Z }

// ── Color wheel (left) ──────────────────────────────
define PathLayer('wheel-fill') ${ fill: wheel; stroke: none; }
layer('wheel-fill').apply { circle(50, 65, 35) }

define PathLayer('wheel-hole') ${ fill: cream; stroke: none; }
layer('wheel-hole').apply { circle(50, 65, 18) }

define PathLayer('wheel-rim') ${ fill: none; stroke: deep; stroke-width: 1; }
layer('wheel-rim').apply { circle(50, 65, 35) }

// ── Gauge (right) ───────────────────────────────────
define PathLayer('gauge-fill') ${ fill: gauge; stroke: none; }
layer('gauge-fill').apply { circle(150, 65, 35) }

define PathLayer('gauge-hole') ${ fill: cream; stroke: none; }
layer('gauge-hole').apply { circle(150, 65, 18) }

define PathLayer('gauge-rim') ${ fill: none; stroke: deep; stroke-width: 1; }
layer('gauge-rim').apply { circle(150, 65, 35) }

// ── Dynamic tick marks around gauge ──────────────────
let ticks = [0, 1, 2, 3, 4, 5, 6, 7, 8];
for ([val, i] in ticks) {
  let angle = calc(135 + i * 33.75);
  let a_rad = calc(angle * 3.14159265 / 180);
  let x1 = calc(150 + 31 * cos(a_rad));
  let y1 = calc(65  + 31 * sin(a_rad));
  let x2 = calc(150 + 38 * cos(a_rad));
  let y2 = calc(65  + 38 * sin(a_rad));

  let name = `tick-${i}`;
  define PathLayer(name) ${ stroke: deep; stroke-width: 1.5; stroke-linecap: round; }
  layer(name).apply { M x1 y1 L x2 y2 }
}

// ── Gauge needle (pointing at ~70%) ──────────────────
let needle_angle = calc((135 + 270 * 0.7) * 3.14159265 / 180);
let nx = calc(150 + 26 * cos(needle_angle));
let ny = calc(65  + 26 * sin(needle_angle));
define PathLayer('needle') ${ stroke: hot; stroke-width: 2; stroke-linecap: round; }
layer('needle').apply { M 150 65 L nx ny }

// ── Spotlight disc (bottom center) ───────────────────
define PathLayer('spot-bg') ${ fill: deep; stroke: none; }
layer('spot-bg').apply { circle(100, 155, 25) }

define PathLayer('spot-fill') ${ fill: spot; stroke: none; }
layer('spot-fill').apply { circle(100, 155, 25) }

define PathLayer('spot-rim') ${ fill: none; stroke: cool; stroke-width: 0.5; }
layer('spot-rim').apply { circle(100, 155, 25) }

// ── Dynamic decorative dots along bottom ─────────────
let dot_positions = [25, 50, 150, 175];
for ([xpos, i] in dot_positions) {
  let dname = `deco-${i}`;
  define PathLayer(dname) ${ fill: hot; stroke: none; opacity: 0.5; }
  layer(dname).apply { circle(xpos, 155, 2.5) }
}

// ═══════════════════════════════════════════════════════
//  Labels
// ═══════════════════════════════════════════════════════

define TextLayer('labels') ${ font-size: 8; fill: deep; font-family: sans-serif; text-anchor: middle; }
layer('labels').apply {
  text(50, 16)`Conic Gradient`
  text(50, 24)`OKLCh · full sweep`
  text(150, 16)`Partial Sweep`
  text(150, 24)`270° gauge · ticks`
  text(100, 192)`Spotlight (30° band)`
}

define TextLayer('footer') ${ font-size: 7; fill: deep; font-family: sans-serif; text-anchor: start; }
layer('footer').apply {
  text(5, 198)`Pattern fill · Reactive CSSVar colors · Dynamic layers`
}
