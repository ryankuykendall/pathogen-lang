// Subscriptions, milestone 2 demo: annotations declared before the drawing.
// - joint dots follow every endpoint of the tab outline
// - labels number the joints in drawing order
// - arc centres (including the fillet's arc) are spoked in red
define ViewBox(0, 0, 260, 170);
define PathLayer('shape') #{ stroke: #333; stroke-width: 2; fill: none; }
define PathLayer('spokes') #{ stroke: #d33; stroke-width: 1; fill: none; }
define PathLayer('dots') #{ fill: #36c; stroke: none; }
define TextLayer('labels') #{ font-size: 9; fill: #36c; font-family: sans-serif; }

let corners = layer('shape').subscribe('endpoint') {|joint, i|
  layer('dots').apply {
    circle(joint.x, joint.y, 3);
  }
  layer('labels').apply {
    text(joint.x + 6, joint.y - 6)`${i}`
  }
};

layer('shape').subscribe('command(a)') {|arc|
  let from = arc.start;
  let hub = arc.center;
  let to = arc.end;
  layer('spokes').apply {
    M from.x from.y;
    L hub.x hub.y;
    L to.x to.y;
  }
};

layer('shape').apply {
  M 30 40;
  h 80;
  a 16 16 0 0 1 16 16;
  v 40;
  a 16 16 0 0 1 -16 16;
  h -80;
  z with fillet(12);
  circle(200, 100, 28);
}

corners.unsubscribe();

layer('shape').apply {
  M 170 30;
  h 40;
  v 20;
}

log(corners);
