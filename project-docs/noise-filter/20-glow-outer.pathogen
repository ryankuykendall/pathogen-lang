// Outer glow around an icon — warm halo simulating a lit-up star.

let halo = GlowFilter() {|f|
  f.mode = GlowMode.Outer;
  f.color = oklch(85% 0.22 70);
  f.radius = 14;
  f.opacity = 0.85;
};

// Background panel for contrast
define PathLayer('bg') ${ fill: oklch(18% 0.02 270); stroke: none; }
layer('bg').apply { rect(0, 0, 200, 200); }

define PathLayer('star') ${ fill: oklch(80% 0.22 60); stroke: none; filter: halo; }
layer('star').apply { star(100, 100, 45, 20, 5); }
