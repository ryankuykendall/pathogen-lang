// Material-style floating card — elevation 12 produces a pronounced,
// hazy shadow that reads as a card lifting significantly off the surface.

let floating = ElevationShadowFilter() {|f|
  f.elevation = 12;
  f.color = oklch(20% 0.04 280);
};

define PathLayer('surface') ${ fill: oklch(94% 0.01 80); stroke: none; }
layer('surface').apply { rect(0, 0, 200, 200); }

define PathLayer('chip') ${ fill: oklch(70% 0.18 30); stroke: none; filter: floating; }
layer('chip').apply { roundRect(50, 60, 100, 60, 14); }
