// Canonical source for the InnerShadowFilter Generated SVG Output section in
// docs/filters.md. If you change this file, update the doc accordingly.
define PathLayer('surface') ${ fill: oklch(94% 0.01 80); stroke: none; }
layer('surface').apply { rect(0, 0, 200, 200); }

let press = InnerShadowFilter() {|f|
  f.offsetX = 0;
  f.offsetY = 3;
  f.blur = 4;
  f.color = oklch(20% 0.02 280);
  f.opacity = 0.5;
};

define PathLayer('button') ${ fill: oklch(80% 0.06 230); stroke: none; filter: press; }
layer('button').apply { roundRect(40, 80, 120, 40, 12); }
