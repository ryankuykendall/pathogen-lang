// Canonical source for the GlowFilter Generated SVG Output section in
// docs/filters.md. If you change this file, update the doc accordingly.
define PathLayer('bg') #{ fill: oklch(18% 0.02 270); stroke: none; }
layer('bg').apply { rect(0, 0, 200, 200); }

let glow = GlowFilter() {|f|
  f.mode = GlowMode.Outer;
  f.color = oklch(85% 0.20 60);
  f.radius = 8;
};

define PathLayer('star') #{ fill: oklch(70% 0.20 30); filter: glow; }
layer('star').apply { star(100, 100, 50, 22, 5); }
