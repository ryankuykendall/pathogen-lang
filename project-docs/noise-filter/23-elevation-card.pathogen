// Material-style resting card — elevation 3 produces a tight, crisp shadow
// that reads as a card lifted just above the surface.

let card = ElevationShadowFilter() {|f|
  f.elevation = 3;
  f.color = oklch(20% 0.04 280);
};

define PathLayer('surface') ${ fill: oklch(94% 0.01 80); stroke: none; }
layer('surface').apply { rect(0, 0, 200, 200); }

define PathLayer('card') ${ fill: white; stroke: none; filter: card; }
layer('card').apply { roundRect(40, 60, 120, 80, 10); }
