//-- cubicBezier demo: six rows of 13 dots, each row spacing its dots by a
//-- different easing of t = i / 12 across the same 30..370 range. The two
//-- faint verticals mark the range; the back curve's dots step outside it.

define ViewBox(0, 0, 400, 270);

let left = 30;
let width = 340;

let smooth = {|t| cubicBezier(0.42, 0, 0.58, 1, t)};
let cssEase = {|t| cubicBezier(0.25, 0.1, 0.25, 1, t)};
let expoOut = {|t| cubicBezier(0.16, 1, 0.3, 1, t)};
let backInOut = {|t| cubicBezier(0.68, -0.6, 0.32, 1.6, t)};

let rails = PathLayer('rails') ${ stroke: #d0d0d8; stroke-width: 1; fill: none; };
rails.apply {
  M left 22
  L left 258
  M calc(left + width) 22
  L calc(left + width) 258
}

let labels = TextLayer('labels') ${ font-family: system-ui, sans-serif; font-size: 10; fill: #666; };
labels.apply {
  text(left, 32)`linear: t`
  text(left, 72)`easeInOut(t): quadratic`
  text(left, 112)`cubicBezier(0.42, 0, 0.58, 1, t): CSS ease-in-out`
  text(left, 152)`cubicBezier(0.25, 0.1, 0.25, 1, t): CSS ease`
  text(left, 192)`cubicBezier(0.16, 1, 0.3, 1, t): expo out`
  text(left, 232)`cubicBezier(0.68, -0.6, 0.32, 1.6, t): back in-out, overshoots the rails`
}

let dots = PathLayer('dots') ${ fill: #c0518e; stroke: none; };
dots.apply {
  for (i in 0..12) {
    let t = i / 12;
    circle(calc(left + width * t), 44, 3);
    circle(calc(left + width * easeInOut(t)), 84, 3);
    circle(calc(left + width * smooth(t)), 124, 3);
    circle(calc(left + width * cssEase(t)), 164, 3);
    circle(calc(left + width * expoOut(t)), 204, 3);
    circle(calc(left + width * backInOut(t)), 244, 3);
  }
}
