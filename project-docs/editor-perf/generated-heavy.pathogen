define ViewBox(0, 0, 1000, 1000);

let ring0 = PathLayer('ring0') << #{ stroke: oklch(0.65 0.16 0); stroke-width: 1.2; fill: none; };
ring0.apply {
  for (i in 0..2200) {
    circle(500 + (300 + 0 * 18) * cos(i * 0.618), 500 + (300 + 0 * 18) * sin(i * 0.618), 3 + (i % 11));
  }
}

