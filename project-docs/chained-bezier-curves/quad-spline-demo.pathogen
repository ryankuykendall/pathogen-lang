// quad-spline-demo.pathogen
// Demonstrates quadSpline — smooth curves through points with implicit angle derivation.

fn quadSpline(start, points, end) {
  M start.x start.y
  let cpx = calc(start.x + start.exit * cos(start.angle));
  let cpy = calc(start.y + start.exit * sin(start.angle));
  if (points.length > 0) {
    Q cpx cpy points[0].x points[0].y
    let prevCPx = cpx;
    let prevCPy = cpy;
    for ([pt, idx] in points) {
      let angle = calc(atan2(pt.y - prevCPy, pt.x - prevCPx));
      let newCPx = calc(pt.x + pt.exit * cos(angle));
      let newCPy = calc(pt.y + pt.exit * sin(angle));
      if (idx < calc(points.length - 1)) {
        Q newCPx newCPy points[calc(idx + 1)].x points[calc(idx + 1)].y
      } else {
        Q newCPx newCPy end.x end.y
      }
      prevCPx = newCPx;
      prevCPy = newCPy;
    }
  } else {
    Q cpx cpy end.x end.y
  }
}

// --- Example 1: Simple Arc ---

define PathLayer('simple-arc') #{ fill: none; stroke: #2563eb; stroke-width: 2; }

layer('simple-arc').apply {
  quadSpline(
    { x: 10, y: 80, angle: 0, exit: 40 },
    [],
    { x: 90, y: 80 }
  );
}


// --- Example 2: Flowing Curve ---

define PathLayer('flowing') #{ fill: none; stroke: #dc2626; stroke-width: 2; }

layer('flowing').apply {
  quadSpline(
    { x: 110, y: 80, angle: -45deg, exit: 30 },
    [
      { x: 140, y: 20, exit: 25 },
      { x: 180, y: 60, exit: 30 },
      { x: 210, y: 20, exit: 25 }
    ],
    { x: 250, y: 80 }
  );
}


// --- Example 3: Zigzag with Smooth Joins ---

define PathLayer('zigzag') #{ fill: none; stroke: #16a34a; stroke-width: 2; }

layer('zigzag').apply {
  quadSpline(
    { x: 270, y: 80, angle: -60deg, exit: 25 },
    [
      { x: 300, y: 20, exit: 25 },
      { x: 330, y: 80, exit: 25 },
      { x: 360, y: 20, exit: 25 }
    ],
    { x: 390, y: 80 }
  );
}
