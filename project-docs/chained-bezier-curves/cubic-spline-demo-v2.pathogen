// cubic-spline-demo-v2.pathogen
// Demonstrates stdlib cubicSpline with S-curve, sine wave, and closed loop examples.
// Phase 2: Uses stdlib cubicSpline — no fn definition needed.

// --- Example 1: S-Curve ---
// Two segments forming a smooth S through three points.

define PathLayer('s-curve') ${ fill: none; stroke: #2563eb; stroke-width: 2 }

layer('s-curve').apply {
  cubicSpline([
    { x: 0,   y: 100, angle: 0, exit: 30 },
    { x: 50,  y: 0,   angle: 0, entry: 30, exit: 30 },
    { x: 100, y: 100, angle: 0, entry: 30 }
  ])
}


// --- Example 2: Sine Wave Approximation ---
// Five-point chain approximating one cycle of a sine wave.

define PathLayer('sine-wave') ${ fill: none; stroke: #dc2626; stroke-width: 2 }

layer('sine-wave').apply {
  cubicSpline([
    { x: 120, y: 50,  angle: 90deg, exit: 20 },
    { x: 145, y: 90,  angle: 0,     entry: 15, exit: 15 },
    { x: 170, y: 50,  angle: 90deg, entry: 20, exit: 20 },
    { x: 195, y: 10,  angle: 0,     entry: 15, exit: 15 },
    { x: 220, y: 50,  angle: 90deg, entry: 20 }
  ])
}


// --- Example 3: Closed Loop ---
// A diamond-like shape with smooth joins.

define PathLayer('closed-loop') ${ fill: rgba(37, 99, 235, 0.1); stroke: #16a34a; stroke-width: 2 }

layer('closed-loop').apply {
  cubicSpline([
    { x: 290, y: 30,  angle: 0,     exit: 20 },
    { x: 340, y: 50,  angle: 90deg, entry: 20, exit: 20 },
    { x: 290, y: 70,  angle: 0,     entry: 20, exit: 20 },
    { x: 240, y: 50,  angle: 90deg, entry: 20, exit: 20 },
    { x: 290, y: 30,  angle: 0,     entry: 20 }
  ])
}
