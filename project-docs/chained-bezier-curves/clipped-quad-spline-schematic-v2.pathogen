// Set viewBox: 600 x 520, width: 600, height: 520
// clippedQuadSpline Schematic — Time-Based Eccentricity Control
// Phase 2: Uses stdlib clippedQuadSpline — no fn definition needed.
//
// Shows how exitTime/entryTime control the position of cubic CPs
// along the arms toward a virtual shared control point.


// =========================================================
//  DIAGRAM 1 — Eccentricity comparison overlay (top)
// =========================================================
// Same geometry, four different time values overlaid

let sAngle = -40deg;
let sExit = 90;

// t = 1.0 (full quadratic — most eccentric)
define PathLayer('t100') ${ fill: none; stroke: #3b82f6; stroke-width: 2.5 }
layer('t100').apply {
  clippedQuadSpline(
    { x: 60, y: 170, angle: sAngle, exit: sExit, exitTime: 1.0 },
    [{ x: 200, y: 40, exit: 80, exitTime: 1.0, entryTime: 1.0 }],
    { x: 340, y: 170, entryTime: 1.0 }
  );
}

// t = 0.75
define PathLayer('t075') ${ fill: none; stroke: #8b5cf6; stroke-width: 2 }
layer('t075').apply {
  clippedQuadSpline(
    { x: 60, y: 170, angle: sAngle, exit: sExit, exitTime: 0.75 },
    [{ x: 200, y: 40, exit: 80, exitTime: 0.75, entryTime: 0.75 }],
    { x: 340, y: 170, entryTime: 0.75 }
  );
}

// t = 0.5
define PathLayer('t050') ${ fill: none; stroke: #ec4899; stroke-width: 2 }
layer('t050').apply {
  clippedQuadSpline(
    { x: 60, y: 170, angle: sAngle, exit: sExit, exitTime: 0.5 },
    [{ x: 200, y: 40, exit: 80, exitTime: 0.5, entryTime: 0.5 }],
    { x: 340, y: 170, entryTime: 0.5 }
  );
}

// t = 0.25
define PathLayer('t025') ${ fill: none; stroke: #f97316; stroke-width: 2 }
layer('t025').apply {
  clippedQuadSpline(
    { x: 60, y: 170, angle: sAngle, exit: sExit, exitTime: 0.25 },
    [{ x: 200, y: 40, exit: 80, exitTime: 0.25, entryTime: 0.25 }],
    { x: 340, y: 170, entryTime: 0.25 }
  );
}

// On-curve points
define PathLayer('pts') ${ fill: #e2e8f0; stroke: #475569; stroke-width: 1.5 }
layer('pts').apply {
  circle(60, 170, 5);
  circle(200, 40, 5);
  circle(340, 170, 5);
}

// Labels & legend
define TextLayer('title') ${ font-size: 12; fill: #e2e8f0; font-family: system-ui, sans-serif }
layer('title').apply {
  text(60, 210)`clippedQuadSpline — Eccentricity Control via exitTime / entryTime`
}

define PathLayer('leg-t100') ${ fill: none; stroke: #3b82f6; stroke-width: 2.5 }
define PathLayer('leg-t075') ${ fill: none; stroke: #8b5cf6; stroke-width: 2 }
define PathLayer('leg-t050') ${ fill: none; stroke: #ec4899; stroke-width: 2 }
define PathLayer('leg-t025') ${ fill: none; stroke: #f97316; stroke-width: 2 }

layer('leg-t100').apply { M 60 230 L 80 230 }
layer('leg-t075').apply { M 60 246 L 80 246 }
layer('leg-t050').apply { M 60 262 L 80 262 }
layer('leg-t025').apply { M 60 278 L 80 278 }

define TextLayer('leg-text') ${ font-size: 10; fill: #cbd5e1; font-family: system-ui, sans-serif }
layer('leg-text').apply {
  text(88, 234)`t = 1.0 — full quadratic (CPs at shared position)`
  text(88, 250)`t = 0.75 — slight dampening`
  text(88, 266)`t = 0.5 — half arm length`
  text(88, 282)`t = 0.25 — heavy dampening (CPs pulled near endpoints)`
}


// =========================================================
//  DIAGRAM 2 — CP placement anatomy (bottom)
// =========================================================
// Single segment showing the virtual shared CP and lerped CPs

let sx = 80;
let sy = 420;
let ex = 340;
let ey = 420;
let sharedX = 210;
let sharedY = 310;
let t = 0.6;

let cp1x = calc(lerp(sx, sharedX, t));
let cp1y = calc(lerp(sy, sharedY, t));
let cp2x = calc(lerp(ex, sharedX, t));
let cp2y = calc(lerp(ey, sharedY, t));

// Virtual shared CP
define PathLayer('virtual-cp') ${ fill: none; stroke: #f59e0b; stroke-width: 1.5; stroke-dasharray: 3 3 }
layer('virtual-cp').apply {
  // Arms from endpoints to shared CP
  M sx sy L sharedX sharedY
  M ex ey L sharedX sharedY
}

define PathLayer('virtual-marker') ${ fill: none; stroke: #f59e0b; stroke-width: 1.5 }
layer('virtual-marker').apply {
  // Diamond marker for virtual CP
  M sharedX calc(sharedY - 6) L calc(sharedX + 6) sharedY L sharedX calc(sharedY + 6) L calc(sharedX - 6) sharedY Z
}

// Lerped CPs (actual)
define PathLayer('actual-cp1') ${ fill: #ef4444; stroke: #7f1d1d; stroke-width: 1 }
define PathLayer('actual-cp2') ${ fill: #22c55e; stroke: #14532d; stroke-width: 1 }
layer('actual-cp1').apply { circle(cp1x, cp1y, 5); }
layer('actual-cp2').apply { circle(cp2x, cp2y, 5); }

// The resulting cubic curve
define PathLayer('result-curve') ${ fill: none; stroke: #8b5cf6; stroke-width: 3 }
layer('result-curve').apply {
  M sx sy C cp1x cp1y cp2x cp2y ex ey
}

// Lerp distance markers
define PathLayer('lerp-marks') ${ fill: none; stroke: #ef4444; stroke-width: 1 }
layer('lerp-marks').apply {
  M sx sy L cp1x cp1y
}

define PathLayer('lerp-marks2') ${ fill: none; stroke: #22c55e; stroke-width: 1 }
layer('lerp-marks2').apply {
  M ex ey L cp2x cp2y
}

// Endpoints
define PathLayer('demo-pts') ${ fill: #8b5cf6; stroke: #3b0764; stroke-width: 1.5 }
layer('demo-pts').apply {
  circle(sx, sy, 5);
  circle(ex, ey, 5);
}

// Annotations
define TextLayer('anatomy-labels') ${ font-size: 10; fill: #cbd5e1; font-family: system-ui, sans-serif }
layer('anatomy-labels').apply {
  text(calc(sharedX + 10), calc(sharedY - 2))`virtual shared CP`
  text(calc(cp1x - 55), calc(cp1y - 8))`CP1 (exit)`
  text(calc(cp2x + 8), calc(cp2y - 8))`CP2 (entry)`
  text(calc(sx - 5), calc(sy + 18))`start`
  text(calc(ex - 5), calc(ey + 18))`end`
}

define TextLayer('anatomy-title') ${ font-size: 11; fill: #f59e0b; font-family: system-ui, sans-serif }
layer('anatomy-title').apply {
  text(80, 305)`Single segment anatomy (t = 0.6)`
}

define TextLayer('anatomy-formula') ${ font-size: 10; fill: #94a3b8; font-family: monospace }
layer('anatomy-formula').apply {
  text(380, 340)`CP1 = lerp(start, sharedCP, exitTime)`
  text(380, 356)`CP2 = lerp(end, sharedCP, entryTime)`
  text(380, 380)`t=1.0: CP at sharedCP (quadratic)`
  text(380, 396)`t=0.0: CP at endpoint (linear)`
}

// Show the quadratic reference (t=1.0) as a faint overlay
define PathLayer('quad-ref') ${ fill: none; stroke: #475569; stroke-width: 1; stroke-dasharray: 4 4 }
layer('quad-ref').apply {
  M sx sy Q sharedX sharedY ex ey
}

define TextLayer('quad-ref-label') ${ font-size: 9; fill: #475569; font-family: system-ui, sans-serif }
layer('quad-ref-label').apply {
  text(180, 480)`quadratic reference (t=1.0)`
}
