// A demo of parts/gears: one gear of each Teeth size.
import { gear, Teeth } from "../parts/gears.pathogen";
import { caption } from "../parts/labels.pathogen";

define ViewBox(0, 0, 300, 110);
define TextLayer('captions') #{ font-size: 11; fill: #555; text-anchor: middle; };

const sizes = [Teeth.Few, Teeth.Standard, Teeth.Fine];
const names = ["Few", "Standard", "Fine"];

for (i in 0..2) {
  gear(Point(50 + i * 100, 45), 34, sizes[i]);
  caption(Point(50 + i * 100, 100), names[i]);
}
