// D5 / ISSUE-027: a conic gradient in a viewBox that does not start at (0, 0).
// The wheel is centred in the picture; the tile must cover the whole viewBox.
define ViewBox(-100, -100, 200, 200);
let g = ConicGradient('g', 0, 0) {|c|
  c.stop(0, Color('#e63946'));
  c.stop(0.5, Color('#f1faee'));
  c.stop(1, Color('#264653'));
};
define default PathLayer('bg') #{ fill: g; stroke: none; };
M -100 -100;
h 200;
v 200;
h -200;
z;
