+/**
+ * Where a PathBlock's position came from (placement audit V3-A). A block's position is
+ * the move it starts with — written or bridged from the origin to its first command —
+ * and two producers of that state are byte-identical afterwards:
+ *
+ * - `'none'`     free-floating: the first command starts at the block's origin.
+ * - `'authored'` the literal says so: `@{ m 10 10 h 20 }` — "offset from the pen".
+ * - `'injected'` a method put it there: a `dash` / `cut` / `.contours` / `.seams` piece
+ *   sits where it sat in its subject, whether or not the subject had a position.
+ *
+ * Only the two derived-block constructors and the literal write it, so a transform
+ * cannot forget it any more than it can forget which constructor to call.
+ */
+export type PathBlockPlacement = 'none' | 'authored' | 'injected';
+export type PlacementInjector = 'dash' | 'cut' | 'contours' | 'seams';
