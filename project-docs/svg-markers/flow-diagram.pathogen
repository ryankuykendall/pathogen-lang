// viewBox: 0 0 500 400
// width: 1000
// height: 800
// Realistic flow diagram using markers — nodes connected by arrows
// that inherit each connection's color via context-stroke.

// Arrow marker for all connections
let arrow = @{
  m 0 0 l 12 6 l -12 6 z
};

let arrowMarker = Marker('flow-arrow', 12, 12) {|m|
  m.append(arrow, ${ fill: context-stroke; stroke: none; });
};
// refX positioned so the arrow tip sits at the endpoint
arrowMarker.refX = 12;
arrowMarker.refY = 6;

// Reusable node shape — a rounded rect
let nodeShape = @{
  roundRect(0, 0, 100, 50, 8);
};

// Layer definitions must precede their usage
define PathLayer('nodes') ${
  fill: Color('#f5f5f5');
  stroke: Color('#264653');
  stroke-width: 2;
}

define PathLayer('data-flow') ${
  stroke: Color('#2a9d8f');
  stroke-width: 3;
  fill: none;
  marker-end: arrowMarker;
}

define PathLayer('control-flow') ${
  stroke: Color('#e76f51');
  stroke-width: 3;
  fill: none;
  marker-end: arrowMarker;
}

define PathLayer('error-flow') ${
  stroke: Color('#e63946');
  stroke-width: 3;
  fill: none;
  stroke-dasharray: '6 4';
  marker-end: arrowMarker;
}

// Four nodes: Input, Process, Output, Error
layer('nodes').apply {
  nodeShape.drawTo(50, 100);
  nodeShape.drawTo(200, 100);
  nodeShape.drawTo(350, 100);
  nodeShape.drawTo(200, 250);
}

// Input (50-150) → Process (200-300) — green data flow
layer('data-flow').apply {
  M 150 125 L 200 125
}

// Process → Output — green data flow
layer('data-flow').apply {
  M 300 125 L 350 125
}

// Process → Error handler — dashed red error flow
layer('error-flow').apply {
  M 250 150 L 250 250
}

// Error handler → Process — orange control flow curving back
layer('control-flow').apply {
  M 200 275 C 100 275 100 125 150 125
}
