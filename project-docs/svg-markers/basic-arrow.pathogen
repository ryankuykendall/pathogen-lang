// viewBox: 0 0 400 200
// width: 800
// height: 400
// Basic arrow marker at end of a line — the simplest marker usage

let arrow = @{
  m 0 0 l 10 5 l -10 5 z
};

let arrowMarker = Marker('arrowhead', 10, 10) {|m|
  m.append(arrow, ${ fill: Color('#333'); });
};

define PathLayer('line') ${
  stroke: Color('#333');
  stroke-width: 3;
  fill: none;
  marker-end: arrowMarker;
}

layer('line').apply {
  M 40 100 L 360 100
}
