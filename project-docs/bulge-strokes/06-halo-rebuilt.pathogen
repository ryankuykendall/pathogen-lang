// viewBox="0 0 400 240"
//-- Stage 6: the halo, rebuilt. Same layered-glow spirit as Stage 0's
//-- original — 16 strokes, widest first, narrower ones stacking on top — but
//-- now every knob has a name, the widths follow a designed envelope instead
//-- of raw randomRange, the texture is deterministic hash jitter (salt =
//-- haloIndex gives each halo its own stream), and recompiling produces
//-- byte-identical output.
//--
//-- Compare with 00-halo-original.pathogen: same silhouette family, but this
//-- one can be tuned bulge by bulge and reproduced exactly.

define ViewBox(0, 0, 400, 240);

fn bulge(t, center, spread) {
  let d = clamp(abs(t - center) / spread, 0, 1);
  return 0.5 * (1 + cos(mpi(d)));
}

fn bulgesOffset(t, base, bulges) {
  let w = base;
  for (b in bulges) {
    w = w + b.peak * pow(bulge(t, b.center, b.spread), b.sharpness);
  }
  return w;
}

fn hash01(i) {
  let s = sin(i * 12.9898) * 43758.5453;
  return s - floor(s);
}

fn jitterFactor(i, salt, amount) {
  return 1 + (hash01(i * 7 + salt * 1013) * 2 - 1) * amount;
}

fn strokeJittered(pathBlock, steps, base1, bulges1, base2, bulges2,
                  jitterAmount, salt, continuity, cap) {
  return pathBlock.compoundVariableOffset() {|vo, pb|
    vo.startCap(cap);
    for (i in 0..steps) {
      let t = i / steps;
      vo.stop(t,
          bulgesOffset(t, base1, bulges1) * jitterFactor(i * 2, salt, jitterAmount),
          continuity,
          bulgesOffset(t, base2, bulges2) * jitterFactor(i * 2 + 1, salt, jitterAmount),
          continuity);
    }
    vo.endCap(cap);
  };
}

let spine = @{ c 80 -100 160 100 240 0 };
let px = 80;
let py = 130;
let taperCap = Cap.tapered(2, CurveContinuity.G0);
let base = oklch(0.72 0.14 20);

//-- Descending 16..1: widest halos paint first, narrow bright core lands last.
for (haloIndex in 16..1) {
  let bulges1 = [{center: 0.35, spread: 0.3, peak: 0.6 * haloIndex, sharpness: 1},
                 {center: 0.78, spread: 0.18, peak: 0.35 * haloIndex, sharpness: 2}];
  let bulges2 = [{center: 0.55, spread: 0.4, peak: -0.3 * haloIndex, sharpness: 1}];

  //-- Bases scale with haloIndex too — constant bases would make all 16
  //-- layers geometrically identical hairlines at the tails, killing the
  //-- glow exactly where the envelope is at its base.
  let halo = strokeJittered(spine, 48,
                            0.15 * haloIndex, bulges1, -0.15 * haloIndex, bulges2,
                            0.2, haloIndex,
                            CurveContinuity.G1, taperCap);

  let haloColor = base.hueShift(calc(haloIndex * -6));
  let haloLayer = PathLayer(`halo-${haloIndex}`) #{
    fill: haloColor;
    stroke: none;
    opacity: 0.25;
  };
  haloLayer.apply {
    M calc(px + halo.anchor.x) calc(py + halo.anchor.y)
    halo.draw();
  }
}
