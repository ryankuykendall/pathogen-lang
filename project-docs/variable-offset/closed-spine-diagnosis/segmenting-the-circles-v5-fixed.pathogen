// Segmenting the circles v5 — corrected with features that exist TODAY.
// Three changes from the original, each marked FIX below. Layout, colors, stop
// times and offsets are the author's, untouched.
define ViewBox(0, 0, 10000, 10000);
define default PathLayer('main-path-layer') #{
  fill: #ffc;
  stroke: none;
  stroke-width: 1;
}
let { width, height } = viewbox;
rect(0, 0, width, height);

let colors = [
  #c00,
  #eee,
];
let fills = Cycler(colors, true);
let discs = [];
for (idx in 1..5) {
  let radii = [];
  let radiusMin = 40;
  let radiusMax = randomRange(120, 720);
  radii.push(radiusMax);
  for (i in 1..calc(round(randomRange(2, 5)))) {
    radii.push(lerp(radiusMin, radiusMax, random()));
  }
  let sortedRadii = radii.sort().reverse();

  let ringGroup = [];
  for ([radius, index] in sortedRadii.mapSlice(2)) {
    // FIX 1 — mapSlice(2) is a sliding window whose LAST slice is short
    // ([r1,r2],[r2,r3],[r3]), so `inner` was null for the innermost ring.
    if (radius.length == 2) {
      let [outer, inner] = radius;
      let spike = outer * randomRange(0.015, 0.065);

      // The author's nine stops, as data: [time, offset, sharp].
      let profile = [
        [0, 5, 0],
        [0.20, 7.5, 0],
        [0.45, 4.5, 0],
        [0.4995, 2, 1],
        [0.5, spike, 1],
        [0.5005, 2, 1],
        [0.55, 4.5, 0],
        [0.80, 7.5, 0],
        [1, 5, 0],
      ];

      // FIX 2 — variableOffset builds a spline THROUGH its stops; the circle's
      // own shape never reaches the output. Nine stops cannot describe a circle,
      // so densify: one stop per ~5 degrees, easing the offset between rows.
      let outerPB = @{
        circle(500, 500, outer);
      }.variableOffset() {|vo, pb|
        for (row in 0..(profile.length - 2)) {
          let [t0, d0, sharp0] = profile[row];
          let [t1, d1, sharp1] = profile[row + 1];
          let steps = max(1, round((t1 - t0) * 72));
          for (step in 0..(steps - 1)) {
            let u = step / steps;
            let continuity = CurveContinuity.G1;
            if (step == 0 && sharp0 == 1) {
              continuity = CurveContinuity.G0;
            }
            vo.stop(lerp(t0, t1, u), lerp(d0, d1, smoothstep(0, 1, u)), continuity);
          }
        }
        vo.stop(1, 5, CurveContinuity.G1);
      };
      let innerPB = @{
        circle(500, 500, inner);
      };

      // FIX 3 — keep the two blocks SEPARATE. `<<` continues from where the left
      // block ENDS (the offset's tip), which is what threw the inner circle
      // +500,+500 off-centre.
      ringGroup.push([outerPB, innerPB]);
    }
  }
  discs.push(ringGroup);
}

for ([group, dIndex] in discs) {
  for ([ring, ringIndex] in group) {
    let [outerPB, innerPB] = ring;
    let fill = fills.pick();
    let chance = random();
    if (chance > 0.25) {
      fill = fill.lighten(calc(0.01 * dIndex)).alpha(lerp(0.8, 0.2, calc(dIndex / discs.length)));
    } else if (chance < 0.075) {
      fill = fill.hueShift(1.2pi).desaturate(35%).lighten(randomRange(0.01, 0.35));
    }

    let radiusLayer = PathLayer(`radius-layer-disc-${dIndex}-${ringIndex}`) #{
      fill: fill;
      fill-rule: evenodd;
      stroke-width: 2;
    };

    let x = calc(((dIndex % 19) * 1500));
    let y = calc((floor(dIndex / 19) * 500));
    radiusLayer.apply {
      // A variableOffset result is normalized to its own first point; `anchor`
      // is the translation that removed. Adding it back registers the offset on
      // its spine, so both subpaths share one origin -> concentric, one <path>.
      outerPB.drawTo(x + outerPB.anchor.x, y + outerPB.anchor.y);
      innerPB.drawTo(x, y);
    }
  }
}
