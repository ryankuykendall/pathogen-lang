// compoundVariableOffset demo — a closed variable-width ribbon (two G2 profiles)
// with a round start cap and a smooth tapered end cap.
define ViewBox(-14, -30, 130, 60);
define PathLayer('ribbon') ${ fill: #93c5fd; stroke: #2563eb; stroke-width: 1; };

let spine = @{ h 100 };

let ribbon = spine.compoundVariableOffset() {|go, pb|
  go.startCap(Cap.round());
  go.stop(8%,   6, CurveContinuity.G2,  -6, CurveContinuity.G2);
  go.stop(35%, 16, CurveContinuity.G2, -10, CurveContinuity.G2);
  go.stop(65%, 12, CurveContinuity.G2, -14, CurveContinuity.G2);
  go.stop(92%, 20, CurveContinuity.G2,  -5, CurveContinuity.G2);
  go.endCap(Cap.tapered(14, CurveContinuity.G2));
};

layer('ribbon').apply {
  ribbon.drawTo(0, 0);
}
