// LB-l-70 — Libre Baskerville Bold "en" tracking 0.7 (O5: peninsula on e)
@font "../../fonts/Libre_Baskerville/LibreBaskerville-Bold.ttf"

let styles = ${ font-family: LibreBaskerville-Bold; font-size: 100; };
let glyphs = PathBlock.fromGlyph("en", styles);
let g0 = glyphs[0];
let g1 = glyphs[1];

let pos1 = calc(g0.advanceWidth * 0.7);
let g0p = g0.project(0, 0);
let g1p = g1.project(pos1, 0);
let combined = g0p.union(g1p);

let bg = PathLayer('bg') ${ fill: '#fefce8'; stroke: none; };
layer('bg').apply { rect(0, 0, 1200, 600); }

let stroke_col = Color('#06b6d4f2');
let underlay_col = Color('#7c2d12e6');

let underlay_stroke_layer = PathLayer('underlay-stroke') ${ fill: none; stroke: underlay_col; stroke-width: 0.5; };
let union_stroke_layer = PathLayer('union-stroke') ${ fill: none; stroke: stroke_col; stroke-width: 0.5; };

let label_layer = TextLayer('labels') ${ font-family: monospace; font-size: 14; fill: '#475569'; text-anchor: start; };
layer('labels').apply {
  text(50, 30)`underlay only (e + n raw, no boolean op)`
  text(700, 30)`e.union(n) result`
}

let dy = 450;
layer('underlay-stroke').apply {
  g0.drawTo(50, dy);
  g1.drawTo(calc(50 + pos1), dy);
}
layer('union-stroke').apply { combined.drawTo(700, dy); }
