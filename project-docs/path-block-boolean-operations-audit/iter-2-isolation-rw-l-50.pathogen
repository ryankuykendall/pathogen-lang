// RW-l-50 — Raleway 200 ExtraLight "en" tracking 0.5
@font "../../fonts/Raleway/Raleway-ExtraLight.ttf"

let styles = #{ font-family: Raleway-ExtraLight; font-size: 22; };
let glyphs = PathBlock.fromGlyph("en", styles);
let g0 = glyphs[0];
let g1 = glyphs[1];

let pos1 = calc(g0.advanceWidth * 0.5);
let g0p = g0.project(0, 0);
let g1p = g1.project(pos1, 0);
let combined = g0p.union(g1p);

let bg = PathLayer('bg') #{ fill: '#fefce8'; stroke: none; };
layer('bg').apply { rect(0, 0, 800, 400); }

let underlay_fill = PathLayer('underlay-fill') #{ fill: '#f9731680'; stroke: none; };
let union_fill = PathLayer('union-fill') #{ fill: '#1e3a8a80'; stroke: none; };
let underlay_stroke = PathLayer('underlay-stroke') #{ fill: none; stroke: '#7c2d12e6'; stroke-width: 0.3; };
let union_stroke = PathLayer('union-stroke') #{ fill: none; stroke: '#06b6d4f2'; stroke-width: 0.3; };

let baseline = 280;
let dx = 200;

layer('underlay-fill').apply { g0.drawTo(dx, baseline); g1.drawTo(calc(dx + pos1), baseline); }
layer('underlay-stroke').apply { g0.drawTo(dx, baseline); g1.drawTo(calc(dx + pos1), baseline); }
layer('union-fill').apply { combined.drawTo(dx, baseline); }
layer('union-stroke').apply { combined.drawTo(dx, baseline); }
