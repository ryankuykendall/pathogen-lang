@font "../../fonts/Playfair_Display/PlayfairDisplay-Bold.ttf"
let styles = #{ font-family: PlayfairDisplay-Bold; font-size: 100; };
let glyphs = PathBlock.fromGlyph("EN", styles);
let g0 = glyphs[0];
let g1 = glyphs[1];
let pos1 = calc(g0.advanceWidth * 0.6);
let g0p = g0.project(0, 0);
let g1p = g1.project(pos1, 0);

log(`E.advanceWidth = ${g0.advanceWidth}`);
log(`N starts at pos1 = ${pos1}`);

let bbE = g0p.boundingBox();
let bbN = g1p.boundingBox();
log(`E bbox: x=[${bbE.x}, ${calc(bbE.x + bbE.width)}], y=[${bbE.y}, ${calc(bbE.y + bbE.height)}]`);
log(`N bbox: x=[${bbN.x}, ${calc(bbN.x + bbN.width)}], y=[${bbN.y}, ${calc(bbN.y + bbN.height)}]`);
