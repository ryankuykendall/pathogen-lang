{
  "name": "pathogen-lang",
  "displayName": "Pathogen Language",
  "description": "Language support for the Pathogen SVG path language",
  "version": "0.0.1",
  "private": true,
  "publisher": "pedestal-design",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:pathogen"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pathogen",
        "aliases": [
          "Pathogen",
          "pathogen"
        ],
        "extensions": [
          ".pathogen"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pathogen",
        "scopeName": "source.pathogen",
        "path": "./syntaxes/pathogen.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pathogen",
        "path": "./snippets/pathogen.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "pathogen.openPreview",
        "title": "Pathogen: Open Preview to the Side",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == pathogen",
          "command": "pathogen.openPreview",
          "group": "navigation"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "pathogen",
        "required": ["file"],
        "properties": {
          "file": {
            "type": "string",
            "description": "The .pathogen file to compile"
          },
          "outputSvg": {
            "type": "string",
            "description": "Output SVG file path"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "pathogen",
        "owner": "pathogen",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^(?:Error: )?Parse error at line (\\d+), column (\\d+): (.+)$",
          "line": 1,
          "column": 2,
          "message": 3
        }
      }
    ],
    "configuration": {
      "title": "Pathogen",
      "properties": {}
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "echo 'No tests yet'"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
