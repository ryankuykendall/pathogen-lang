{
  "name": "vscode-pathogen",
  "displayName": "Pathogen Language",
  "description": "Language support for the Pathogen SVG path language",
  "version": "0.0.1",
  "private": true,
  "publisher": "pedestal-design",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:pathogen"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pathogen",
        "aliases": [
          "Pathogen",
          "pathogen"
        ],
        "extensions": [
          ".pathogen"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pathogen-light.svg",
          "dark": "./icons/pathogen-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "pathogen",
        "scopeName": "source.pathogen",
        "path": "./syntaxes/pathogen.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pathogen",
        "path": "./snippets/pathogen.code-snippets"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "echo 'No tests yet'"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
