{
  "name": "vscode-pathogen",
  "displayName": "Pathogen Language",
  "description": "Language support for the Pathogen SVG path language",
  "version": "0.0.1",
  "private": true,
  "publisher": "pedestal-design",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:pathogen"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pathogen",
        "aliases": [
          "Pathogen",
          "pathogen"
        ],
        "extensions": [
          ".pathogen"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pathogen-light.svg",
          "dark": "./icons/pathogen-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "pathogen",
        "scopeName": "source.pathogen",
        "path": "./syntaxes/pathogen.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pathogen",
        "path": "./snippets/pathogen.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "pathogen.openPreview",
        "title": "Pathogen: Open Preview to the Side",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == pathogen",
          "command": "pathogen.openPreview",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Pathogen",
      "properties": {
        "pathogen.preview.viewBox": {
          "type": "string",
          "default": "0 0 200 200",
          "description": "SVG viewBox for the preview panel"
        },
        "pathogen.preview.stroke": {
          "type": "string",
          "default": "#000",
          "description": "Default stroke color for preview"
        },
        "pathogen.preview.fill": {
          "type": "string",
          "default": "none",
          "description": "Default fill color for preview"
        },
        "pathogen.preview.strokeWidth": {
          "type": "string",
          "default": "2",
          "description": "Default stroke width for preview"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "echo 'No tests yet'"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
